<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- web/ is the Next.js console with its node_modules: not part of this project's items. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);web/**</DefaultItemExcludes>
    <UpdateKeyFile Condition="'$(UpdateKeyFile)' == ''">$(MSBuildThisFileDirectory)Hosting/update-key.pem</UpdateKeyFile>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>HiveBDC</AssemblyName>
    <RootNamespace>Balsoft.Hive.BDC</RootNamespace>
    <Product>Hive BDC, by Balsoft</Product>
    <AssemblyTitle>Hive BDC</AssemblyTitle>
    <Company>Balsoft GmbH</Company>
    <Copyright>© Balsoft GmbH</Copyright>
    <Version>1.10.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WPF dashboard lives under app/ (its own project). Keep the service's
         root-glob from swallowing it — the app builds only via HiveBDC.App.csproj. -->
    <Compile Remove="app\**\*.cs;tests\**\*.cs;setup\**\*.cs" />
    <EmbeddedResource Remove="app\**;tests\**" />
    <None Remove="app\**;tests\**;setup\**" />
    <Page Remove="app\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Balsoft.Hive.BDC.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web console (web/, Next.js) is not part of this build: deploy/azure/package.sh builds it and puts the
         static export into the Azure package's console/ folder, which Hosting/ConsoleSite.cs serves. -->
    <!-- Metric twins of the Office fonts for Word to PDF where they are not installed (Linux App Service). -->
    <EmbeddedResource Include="Documents\Word\Fonts\*.ttf;Documents\Word\Fonts\*.txt">
      <LogicalName>Balsoft.Hive.BDC.Fonts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Remove="Documents\Word\Fonts\**" />
    <!-- The public half of Balsoft's update key; a build without it never updates itself (design part 15b). -->
    <EmbeddedResource Include="$(UpdateKeyFile)" Condition="'$(UpdateKeyFile)' != '' And Exists('$(UpdateKeyFile)')">
      <LogicalName>Balsoft.Hive.BDC.update-key.pem</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Trusted public cert for license verification (compiled in so it can't be swapped). -->
    <EmbeddedResource Include="build\BalsoftGmbH.cer">
      <LogicalName>Balsoft.Hive.BDC.BalsoftGmbH.cer</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- Pin the native SQLite bundle above the version Microsoft.Data.Sqlite pulls in
         transitively to clear advisory GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Balsoft.Hive.EInvoice.Pdf" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- CopyToPublishDirectory is stated explicitly: SDK 10.0.301 no longer
         infers it from CopyToOutputDirectory for single-file publishes.
         Always, not PreserveNewest: a single-file publish cleans its output
         folder, and PreserveNewest then skipped the re-copy, so the installer build
         failed on a missing appsettings.json (2026-08-01). -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Update="install.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Update="uninstall.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
