{
  "name": "hive-bdc-console",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3300",
    "build": "next build && tsx scripts/csp-hashes.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src scripts tests *.ts *.json README.md",
    "format:check": "prettier --check src scripts tests *.ts *.json"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.7",
    "lucide-react": "0.577.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
