{
  // ============================================================
  //  Hive BDC, by Balsoft — settings
  //  Normally managed from the dashboard (Settings), which writes this file
  //  atomically; the service picks up edits live, no restart needed.
  //  Use DOUBLE backslashes in paths:  C:\\Temp\\HiveBDC
  //  UNC paths are fine:               \\\\server\\share\\Hive BDC
  // ============================================================
  "HiveBDC": {
    // Seconds to wait between folder scans.
    "PollSeconds": 30,

    // Folder for rolling daily log files (hive-bdc-<date>.log, last 31 kept).
    // Blank = C:\ProgramData\HiveBDC\logs. Must be writable by the run-as account.
    "LogDir": "",

    // Licensing: path to the signed .lic file (blank = license.lic next to the exe,
    // then %ProgramData%\HiveBDC\license.lic). A valid license is ALWAYS required:
    // with none installed (or once expired past the 7-day grace) processing stops.
    // The license lists FEATURES: "einvoice" unlocks the e-invoice handler
    // (XRechnung/ZUGFeRD), "documents" unlocks the PDF pass-through types. A document
    // whose feature the license lacks waits in the input folder until a license with
    // that feature is installed.
    "License": {
      "File": ""
    },

    // SHARED SharePoint app — one Entra ID app registration used for EVERY upload.
    // Needs APPLICATION permission Sites.ReadWrite.All (or Sites.Selected on the sites).
    // The dashboard writes ClientSecret DPAPI-encrypted ("enc:..."); a hand-edited
    // plaintext secret works too. Verify with:  HiveBDC --test-sharepoint
    "SharePointAuth": {
      "TenantId": "",       // Entra tenant GUID
      "ClientId": "",       // app registration (client) ID
      "ClientSecret": ""    // plaintext or dashboard-encrypted "enc:..."
    },

    // Document mail. After a successful export the produced file is mailed via Microsoft
    // Graph. Its OWN app registration, because sending needs the APPLICATION permission
    // Mail.Send, which the SharePoint app is not granted; the tenant is the SharePointAuth
    // tenant unless TenantId below overrides it. Managed from the dashboard; verify
    // with:  HiveBDC --test-mail
    //
    // Recipients, subject and body come from the document JSON (recipientEmail,
    // recipientEmailCc, emailSubject, emailBody). WHO actually receives it depends on the
    // "environment" the AX export stamps on the document: only "Live" reaches the
    // customer or vendor. Anything else - Test, Dev, or an export that carries no
    // environment at all - goes to RedirectTo instead, with the real recipients named in
    // the body. Per document type, mail can be switched off ("Mail": false below).
    "Mail": {
      "Enabled": false,
      "TenantId": "",       // blank = the SharePointAuth tenant
      "ClientId": "",       // app registration (client) ID with Mail.Send
      "ClientSecret": "",   // plaintext or dashboard-encrypted "enc:..."
      "From": "",           // mailbox documents are sent as, e.g. rechnung@example.de
      // Where non-production documents go instead of to the partner. Either one address per
      // entry, or a single entry holding a ";" separated list - both are accepted.
      "RedirectTo": [],
      "SaveToSentItems": true
    },

    // The document types the service dispatches. "Id" is what the ERP writes as
    // "documentType" into the JSON (case-insensitive) and names the output sub-folder.
    //   Party:   Customer | Vendor      (who the document goes to)
    //   Handler: EInvoice | Pdf         (EInvoice = XRechnung/ZUGFeRD from the JSON;
    //                                    Pdf = deliver the ERP's PDF as it is)
    //   Mail:    per-type switch on top of the global Mail settings.
    //   Companies: ONE ENTRY PER AX COMPANY this type is picked up for:
    //     DataAreaId  the AX company (the JSON's dataAreaId selects the entry when a
    //                 folder serves several companies; one company per folder needs none)
    //     Input       folder scanned for {documentId}_xxx.json + matching .pdf pairs;
    //                 several types may share one folder, the JSON's documentType tells
    //                 them apart; a folder used by ONE type implies that type for a JSON
    //                 without documentType
    //     Output      blank = <Input>\out\<Id>
    //     SharePoint  Enabled + SiteUrl + Library (+ optional Folder); Fields maps
    //                 SharePoint INTERNAL column names to templates: {property} takes any
    //                 top-level field of the JSON (case-insensitive), {property:date}
    //                 normalizes to yyyy-MM-dd; empty results are skipped
    // A documentType the ERP sends that is not listed here is ADDED automatically as a
    // Pdf type routed like the company entry of the folder it arrived in (marked
    // "Discovered": true until it is saved from the dashboard).
    "DocumentTypes": [
      {
        "Id": "SalesInvoice", "DisplayName": "Sales invoice", "Party": "Customer", "Handler": "EInvoice", "Enabled": true, "Mail": true,
        "Companies": [
          {
            "DataAreaId": "default",
            "Input": "C:\\Temp\\HiveBDC",
            "Output": "",
            "SharePoint": {
              "Enabled": false,
              "SiteUrl": "",     // https://tenant.sharepoint.com/sites/Name
              "Library": "",     // document library display name
              "Folder": "",      // optional folder inside the library, e.g. "2026/Q3"
              "Fields": { "Title": "{DocumentNumber}" }
            }
          }
        ]
      },
      { "Id": "SalesConfirmation", "DisplayName": "Order confirmation", "Party": "Customer", "Handler": "Pdf", "Enabled": true, "Mail": true,
        "Companies": [ { "DataAreaId": "default", "Input": "C:\\Temp\\HiveBDC", "Output": "", "SharePoint": { "Enabled": false, "SiteUrl": "", "Library": "", "Folder": "", "Fields": { "Title": "{DocumentNumber}" } } } ] },
      { "Id": "SalesQuotation",    "DisplayName": "Quotation",          "Party": "Customer", "Handler": "Pdf", "Enabled": true, "Mail": true,
        "Companies": [ { "DataAreaId": "default", "Input": "C:\\Temp\\HiveBDC", "Output": "", "SharePoint": { "Enabled": false, "SiteUrl": "", "Library": "", "Folder": "", "Fields": { "Title": "{DocumentNumber}" } } } ] },
      { "Id": "CollectionLetter",  "DisplayName": "Collection letter",  "Party": "Customer", "Handler": "Pdf", "Enabled": true, "Mail": true,
        "Companies": [ { "DataAreaId": "default", "Input": "C:\\Temp\\HiveBDC", "Output": "", "SharePoint": { "Enabled": false, "SiteUrl": "", "Library": "", "Folder": "", "Fields": { "Title": "{DocumentNumber}" } } } ] },
      { "Id": "PurchaseOrder",     "DisplayName": "Purchase order",     "Party": "Vendor",   "Handler": "Pdf", "Enabled": true, "Mail": true,
        "Companies": [ { "DataAreaId": "default", "Input": "C:\\Temp\\HiveBDC", "Output": "", "SharePoint": { "Enabled": false, "SiteUrl": "", "Library": "", "Folder": "", "Fields": { "Title": "{DocumentNumber}" } } } ] },
      { "Id": "PaymentAdvice",     "DisplayName": "Payment advice",     "Party": "Vendor",   "Handler": "Pdf", "Enabled": true, "Mail": true,
        "Companies": [ { "DataAreaId": "default", "Input": "C:\\Temp\\HiveBDC", "Output": "", "SharePoint": { "Enabled": false, "SiteUrl": "", "Library": "", "Folder": "", "Fields": { "Title": "{DocumentNumber}" } } } ] }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft": "Warning"
    }
  }
}
