<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hive BDC's Setup.exe: Balsoft.Hive.Installer.Windows plus Hive BDC's product data
       (Program.cs). build/publish-and-sign.ps1 passes the signed program files as
       InstallerPayloadDirectory; a build without it compiles but such a Setup refuses to run. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Balsoft.Hive.BDC.Setup</RootNamespace>
    <AssemblyName>HiveBDC-Setup</AssemblyName>
    <Product>Hive BDC Setup, by Balsoft</Product>
    <AssemblyTitle>Hive BDC Setup</AssemblyTitle>
    <Company>Balsoft GmbH</Company>
    <Copyright>© Balsoft GmbH</Copyright>
    <Version>1.2.0</Version>
    <ApplicationIcon>..\..\app\HiveBDC.App\Assets\hive-bdc.ico</ApplicationIcon>
    <!-- Setup always runs elevated: it writes to Program Files, HKLM and the service manager. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Balsoft.Hive.Installer.Windows" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\build\wizard-image.png" Link="Assets\wizard-image.png" />
    <Resource Include="..\..\app\HiveBDC.App\Assets\hive-bdc-logo.png" Link="Assets\hive-bdc-logo.png" />
    <EmbeddedResource Include="..\..\build\EULA.txt" LogicalName="eula.txt" />
  </ItemGroup>

</Project>
