<Window x:Class="Balsoft.Hive.BDC.App.DocumentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hive BDC — Documents" Height="700" Width="1120"
        MinHeight="420" MinWidth="760"
        Icon="/Assets/hive-bdc-logo.png"
        FontFamily="Segoe UI, Tahoma"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBg}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Documents" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#93A3BC"
                                   Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ByType}" Foreground="#93A3BC" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Documents}" IsReadOnly="True"
                      MouseDoubleClick="Document_DoubleClick"
                      ToolTip="Double-click a row to open its produced file">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Document ID" Binding="{Binding DocumentId}" Width="*"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding DataAreaId}" Width="90"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding DocumentType}" Width="150"/>
                    <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="90"/>
                    <DataGridTextColumn Header="Exported" Binding="{Binding ExportedAt}" Width="160"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/>
                    <DataGridTextColumn Header="SharePoint" Binding="{Binding TargetSite}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
