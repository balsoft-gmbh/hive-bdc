<Window x:Class="Balsoft.Hive.BDC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Balsoft.Hive.BDC.App.Pages"
        Title="Hive BDC" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/hive-bdc-logo.png"
        FontFamily="{StaticResource Font.Body}" FontSize="{StaticResource Size.Body}"
        Foreground="{StaticResource Text}" Background="{StaticResource Canvas}"
        UseLayoutRounding="True" PreviewKeyDown="OnWindowKeyDown">
    <Grid>
        <Grid x:Name="Layout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10,10,10,12">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource LinkButton}" Padding="10,6,10,12" Click="OnBrand"
                            AutomationProperties.AutomationId="Brand" AutomationProperties.Name="Hive BDC, back to the overview" ToolTip="Back to the overview">
                        <StackPanel Orientation="Horizontal">
                            <Control Style="{StaticResource BrandLogo}" Width="100" VerticalAlignment="Center"/>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Margin="10,0,0,0" Padding="10,1,0,1" VerticalAlignment="Center">
                                <TextBlock Text="Hive BDC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}"
                            Background="{StaticResource Surface}" Padding="10,9" Margin="4,0,4,10"
                            ToolTip="{Binding Dashboard.LicenseMessage}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileMark}" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Icon.ServerCog}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Dashboard.LicenseCustomer}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Dashboard.LicenseCustomer}" Value="—">
                                                    <Setter Property="Text" Value="Hive BDC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding MachineName}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}"
                            Padding="10,8" Margin="0,12,0,0" ToolTip="Signed in to Windows">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Avatar}">
                                <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel AutomationProperties.Name="Main navigation">
                            <TextBlock Text="WORK" Style="{StaticResource NavLabel}"/>
                            <Button Style="{StaticResource NavItem}" Tag="Overview" Click="OnNav"
                                    AutomationProperties.AutomationId="NavOverview" AutomationProperties.Name="Overview">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource NavIcon}" Tag="{StaticResource Icon.LayoutDashboard}"/>
                                    <TextBlock Text="Overview" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItem}" Tag="History" Click="OnNav"
                                    AutomationProperties.AutomationId="NavHistory" AutomationProperties.Name="Document history">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource NavIcon}" Tag="{StaticResource Icon.History}"/>
                                    <TextBlock Text="Document history" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="SET UP" Style="{StaticResource NavLabel}"/>
                            <Button Style="{StaticResource NavItem}" Tag="Outbound" Click="OnNav"
                                    AutomationProperties.AutomationId="NavOutbound" AutomationProperties.Name="Outbound">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource NavIcon}" Tag="{StaticResource Icon.FileOutput}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Outbound"/>
                                        <TextBlock Text="from your ERP" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItem}" Tag="Inbound" Click="OnNav"
                                    AutomationProperties.AutomationId="NavInbound" AutomationProperties.Name="Inbound">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource NavIcon}" Tag="{StaticResource Icon.FileInput}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Inbound"/>
                                        <TextBlock Text="into your ERP" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItem}" Tag="Connections" Click="OnNav"
                                    AutomationProperties.AutomationId="NavConnections" AutomationProperties.Name="Connections">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource NavIcon}" Tag="{StaticResource Icon.Cable}"/>
                                    <TextBlock Text="Connections" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItem}" Tag="Service" Click="OnNav"
                                    AutomationProperties.AutomationId="NavService" AutomationProperties.Name="Service">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource NavIcon}" Tag="{StaticResource Icon.ServerCog}"/>
                                    <TextBlock Text="Service" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0,16,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Dashboard.ActionMessage}" Style="{StaticResource MutedText}" FontSize="12" MaxWidth="340"
                                       Margin="0,0,16,0" ToolTip="{Binding Dashboard.ActionMessage}" AutomationProperties.AutomationId="ActionMessage"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Dashboard.ConnectionText}"
                                        AutomationProperties.AutomationId="ServiceState">
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Dashboard.IsRunning, Converter={StaticResource RunningToBrush}}"/>
                                <TextBlock Text="{Binding Dashboard.ServiceStatus}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Margin="10,0,0,0" Command="{Binding Dashboard.RefreshCommand}"
                                    ToolTip="Refresh" AutomationProperties.AutomationId="Refresh" AutomationProperties.Name="Refresh">
                                <ContentControl Style="{StaticResource IconSmall}" Tag="{StaticResource Icon.RefreshCw}"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="13" AutomationProperties.Name="Breadcrumb">
                            <Button Style="{StaticResource CrumbButton}" Content="Hive BDC" Click="OnBrand" AutomationProperties.AutomationId="CrumbHome"/>
                            <ContentControl Style="{StaticResource IconTiny}" Tag="{StaticResource Icon.ChevronRight}" Foreground="{StaticResource Chevron}" Margin="10,0"/>
                            <TextBlock Text="Overview" FontWeight="Medium" VerticalAlignment="Center"
                                       Visibility="{Binding Page, Converter={StaticResource Match}, ConverterParameter=Overview}"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Page, Converter={StaticResource Match}, ConverterParameter=History}">
                                <TextBlock Text="Document history" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource IconTiny}" Tag="{StaticResource Icon.ChevronRight}" Foreground="{StaticResource Chevron}" Margin="10,0"/>
                                <TextBlock Text="{Binding HistoryTabTitle}" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Page, Converter={StaticResource Match}, ConverterParameter=Service}">
                                <TextBlock Text="Service" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource IconTiny}" Tag="{StaticResource Icon.ChevronRight}" Foreground="{StaticResource Chevron}" Margin="10,0"/>
                                <TextBlock Text="{Binding ServiceTabTitle}" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DataContext="{Binding Settings}"
                                        Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Match}, ConverterParameter=Outbound|Inbound|Connections}">
                                <Button Style="{StaticResource CrumbButton}" Content="{Binding Page}" Command="{Binding ShowPageCommand}" CommandParameter="{Binding Page}"
                                        AutomationProperties.AutomationId="CrumbPage"
                                        Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=!Outbound|Inbound|Connections}"/>
                                <TextBlock Text="{Binding Page}" FontWeight="Medium" VerticalAlignment="Center"
                                           Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound|Inbound|Connections}"/>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/type|Outbound/company|Outbound/sharepoint|Outbound/pick-destination|Outbound/destination|Inbound/type|Inbound/company|Inbound/pick}">
                                    <ContentControl Style="{StaticResource IconTiny}" Tag="{StaticResource Icon.ChevronRight}" Foreground="{StaticResource Chevron}" Margin="10,0"/>
                                    <Button Style="{StaticResource CrumbButton}" Content="{Binding CrumbType}" Command="{Binding OpenCommand}" CommandParameter="type"
                                            AutomationProperties.AutomationId="CrumbType"
                                            Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=!Outbound/type|Inbound/type}"/>
                                    <TextBlock Text="{Binding CrumbType}" FontWeight="Medium" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/type|Inbound/type}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/company|Outbound/sharepoint|Outbound/pick-destination|Outbound/destination|Inbound/company}">
                                    <ContentControl Style="{StaticResource IconTiny}" Tag="{StaticResource Icon.ChevronRight}" Foreground="{StaticResource Chevron}" Margin="10,0"/>
                                    <Button Style="{StaticResource CrumbButton}" Content="{Binding CrumbCompany}" Command="{Binding OpenCommand}" CommandParameter="company"
                                            AutomationProperties.AutomationId="CrumbCompany"
                                            Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/sharepoint|Outbound/pick-destination|Outbound/destination}"/>
                                    <TextBlock Text="{Binding CrumbCompany}" FontWeight="Medium" VerticalAlignment="Center"
                                               Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/company|Inbound/company}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/sharepoint|Outbound/pick-destination|Outbound/destination|Inbound/pick|Connections/sharepoint-app|Connections/mail|Connections/docuware|Connections/conn}">
                                    <ContentControl Style="{StaticResource IconTiny}" Tag="{StaticResource Icon.ChevronRight}" Foreground="{StaticResource Chevron}" Margin="10,0"/>
                                    <TextBlock FontWeight="Medium" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding View}" Value="Outbound/sharepoint"><Setter Property="Text" Value="SharePoint library"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding View}" Value="Outbound/pick-destination"><Setter Property="Text" Value="Add a destination"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding View}" Value="Outbound/destination"><Setter Property="Text" Value="{Binding OpenDestination.Title}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding View}" Value="Inbound/pick"><Setter Property="Text" Value="Where from"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding View}" Value="Connections/sharepoint-app"><Setter Property="Text" Value="SharePoint"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding View}" Value="Connections/mail"><Setter Property="Text" Value="Document mail"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding View}" Value="Connections/docuware"><Setter Property="Text" Value="DocuWare"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding View}" Value="Connections/conn"><Setter Property="Text" Value="{Binding OpenConnection.Title}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,0" Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource NoticeError}" Margin="0,14,0,0" DataContext="{Binding Settings}"
                            Visibility="{Binding ValidationErrors.Count, Converter={StaticResource CountToVis}}">
                        <StackPanel>
                            <TextBlock Text="Please fix before saving" FontWeight="SemiBold" Foreground="{StaticResource Danger}"/>
                            <ItemsControl ItemsSource="{Binding ValidationErrors}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Danger}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Notice}" Margin="0,14,0,0" DataContext="{Binding Settings}"
                            Visibility="{Binding ImportNotes.Count, Converter={StaticResource CountToVis}}">
                        <ItemsControl ItemsSource="{Binding ImportNotes}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,1" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2">
                    <pages:OverviewPage x:Name="OverviewView" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Match}, ConverterParameter=Overview}"/>
                    <pages:HistoryPage x:Name="HistoryView" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Match}, ConverterParameter=History}"/>
                    <pages:OutboundPage x:Name="OutboundView" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Match}, ConverterParameter=Outbound}"/>
                    <pages:InboundPage x:Name="InboundView" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Match}, ConverterParameter=Inbound}"/>
                    <pages:ConnectionsPage x:Name="ConnectionsView" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Match}, ConverterParameter=Connections}"/>
                    <pages:ServicePage x:Name="ServiceView" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Match}, ConverterParameter=Service}"/>
                </Grid>

                <Border Grid.Row="3" Margin="24,0,24,16" Padding="16,8,10,8" CornerRadius="{StaticResource Radius}" BorderThickness="1"
                        Visibility="{Binding ShowSaveBar, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Settings changes">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Surface}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConfirmLeave}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerLine}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <DockPanel Visibility="{Binding ConfirmLeave, Converter={StaticResource Match}, ConverterParameter=False}">
                            <Button DockPanel.Dock="Right" Content="Save changes" Style="{StaticResource PrimaryButton}" Click="OnSave"
                                    AutomationProperties.AutomationId="SaveSettings"
                                    IsEnabled="{Binding Settings.IsBusy, Converter={StaticResource InverseBool}}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" DataContext="{Binding Settings}">
                                <Border Style="{StaticResource BadgeGreen}" Margin="0,0,10,0" Visibility="{Binding JustSaved, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource IconTiny}" Tag="{StaticResource Icon.Check}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Saved" AutomationProperties.AutomationId="SavedBadge"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding StatusMessage}" Tag="{Binding StatusIsError}" Style="{StaticResource ResultText}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding StatusMessage}" AutomationProperties.AutomationId="SettingsStatus"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Visibility="{Binding ConfirmLeave, Converter={StaticResource BoolToVis}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Keep editing" Click="OnKeepEditing" Margin="0,0,8,0" AutomationProperties.AutomationId="KeepEditing"/>
                                <Button Content="{Binding LeaveAction}" Style="{StaticResource DangerSolidButton}" Click="OnLeaveWithoutSaving"
                                        AutomationProperties.AutomationId="LeaveWithoutSaving"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LeaveQuestion}" FontWeight="SemiBold" Foreground="{StaticResource Danger}" FontSize="13"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="DialogLayer" Background="{StaticResource Scrim}" Visibility="Collapsed">
            <ContentControl x:Name="DialogHost" Focusable="False" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                            KeyboardNavigation.TabNavigation="Cycle"/>
        </Grid>
    </Grid>
</Window>