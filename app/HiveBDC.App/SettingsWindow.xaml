            <!-- ══ Outbound / one document type: its settings and its companies ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/type}">
                <StackPanel Margin="40,8,40,24" DataContext="{Binding SelectedDocumentType}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Content="Active" FontSize="14" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource PageTitle}"/>
                            <Border Style="{StaticResource ExportBadge}"><TextBlock Text="OUTBOUND" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11"/></Border>
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="DOCUMENT TYPE" Style="{StaticResource PanelTitle}"/>
