<Window x:Class="Balsoft.Hive.BDC.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Balsoft.Hive.BDC.App.Converters"
        Title="Hive BDC: Settings" Height="840" Width="1240"
        MinHeight="560" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/hive-bdc-logo.png"
        FontFamily="Segoe UI Variable Text, Segoe UI, Tahoma"
        Background="#F4F6F9">
    <Window.Resources>
        <conv:MatchToVisibilityConverter x:Key="Match"/>
        <conv:AllEqualConverter x:Key="AllEqual"/>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5B6474"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E8EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="BrowseBtn" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AddBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="14,12">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off switch for CheckBox -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="track" Width="42" Height="24" CornerRadius="12" Background="#CBD5E1">
                                <Ellipse x:Name="thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#16A34A"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="track" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Two-way segmented choice (RadioButton) -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="seg" CornerRadius="8" Padding="10,8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="White"/>
                                <Setter TargetName="seg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left menu entry; selected when its Tag equals the current page -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Padding="12,9" Margin="0,0,0,4" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#16213A"/>
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource AllEqual}">
                                        <Binding Path="Page"/>
                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="b" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FCB608"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinRowHeight" Value="32"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- Status pill: Tag "ok", "setup" or "off" -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Background" Value="#F0FDF4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- A button without chrome: the clickable part of a list card -->
        <Style x:Key="Bare" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E8EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Chevron" TargetType="Path">
            <Setter Property="Data" Value="M0,0 L6,6 L0,12"/>
            <Setter Property="Stroke" Value="#94A3B8"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Crumb" TargetType="Path">
            <Setter Property="Data" Value="M0,0 L4,4 L0,8"/>
            <Setter Property="Stroke" Value="#94A3B8"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,1,10,0"/>
        </Style>
        <Style x:Key="QuietLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6,4">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Foreground" Value="#B91C1C"/>
                                <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerSmall" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="ExportBadge" TargetType="Border">
            <Setter Property="Background" Value="#EEF4FF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ Left menu ══════════ -->
        <Border Grid.Column="0" Background="#0F172A" Padding="14,22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Path Data="M14,2 L24.4,8 L24.4,20 L14,26 L3.6,20 L3.6,8 Z" Fill="#FCB608" Width="28" Height="28" Stretch="Uniform"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Hive BDC" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Settings" Foreground="#94A3B8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource NavBtn}" Tag="Export" AutomationProperties.AutomationId="NavExport" AutomationProperties.Name="Export"
                            Command="{Binding ShowPageCommand}" CommandParameter="Export">
                        <StackPanel>
                            <TextBlock Text="Export" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="from your ERP" FontSize="11.5" Opacity="0.75"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Tag="Import" AutomationProperties.AutomationId="NavImport" AutomationProperties.Name="Import"
                            Command="{Binding ShowPageCommand}" CommandParameter="Import">
                        <StackPanel>
                            <TextBlock Text="Import" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="into your ERP" FontSize="11.5" Opacity="0.75"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Tag="Connections" AutomationProperties.AutomationId="NavConnections" AutomationProperties.Name="Connections"
                            Command="{Binding ShowPageCommand}" CommandParameter="Connections">
                        <TextBlock Text="Connections" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Tag="Service" AutomationProperties.AutomationId="NavService" AutomationProperties.Name="Service"
                            Command="{Binding ShowPageCommand}" CommandParameter="Service">
                        <TextBlock Text="Service" FontSize="14"/>
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="8,0" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"
                           Text="Changes take effect when you save. The service does not restart."/>
                <Border/>
            </DockPanel>
        </Border>

        <!-- ══════════ Content ══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="40,20,40,0">
                <!-- Breadcrumb: the levels above the current screen -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                            Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=!Export|Import|Connections|Service}">
                    <Button Style="{StaticResource LinkBtn}" Command="{Binding ShowPageCommand}" CommandParameter="{Binding Page}"
                            AutomationProperties.AutomationId="CrumbPage">
                        <TextBlock Text="{Binding Page}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Export/company|Export/sharepoint}">
                        <Path Style="{StaticResource Crumb}"/>
                        <Button Style="{StaticResource LinkBtn}" Command="{Binding OpenCommand}" CommandParameter="type" AutomationProperties.AutomationId="CrumbType">
                            <TextBlock Text="{Binding SelectedDocumentType.Label}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Export/sharepoint}">
                        <Path Style="{StaticResource Crumb}"/>
                        <Button Style="{StaticResource LinkBtn}" Command="{Binding OpenCommand}" CommandParameter="company" AutomationProperties.AutomationId="CrumbCompany">
                            <TextBlock Text="{Binding SelectedDocumentType.SelectedCompany.TabTitle}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,8,0,0"
                        Visibility="{Binding ValidationErrors.Count, Converter={StaticResource CountToVis}}">
                    <StackPanel>
                        <TextBlock Text="Please fix before saving" FontWeight="SemiBold" Foreground="#B91C1C"/>
                        <ItemsControl ItemsSource="{Binding ValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#B91C1C" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,8,0,0"
                        Visibility="{Binding ImportNotes.Count, Converter={StaticResource CountToVis}}">
                    <ItemsControl ItemsSource="{Binding ImportNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#1E3A8A" FontSize="12" Margin="0,1" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- ══ Export: the document types ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Export}">
                <StackPanel Margin="40,12,40,24">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+ New document type" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                Command="{Binding NewDocumentTypeCommand}" Padding="16,9" AutomationProperties.AutomationId="NewType"/>
                        <StackPanel>
                            <TextBlock Text="Export" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Documents your ERP posts, and where Hive BDC delivers them. Open a document type to set it up." Foreground="#5B6474" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,16,0,18" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#0F172A" CornerRadius="6" Padding="10,4"><TextBlock Text="ERP" Foreground="White" FontWeight="Bold" FontSize="12"/></Border>
                            <Path Data="M0,6 L26,6 M20,1 L26,6 L20,11" Stroke="#64748B" StrokeThickness="1.8" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hive BDC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="M0,6 L26,6 M20,1 L26,6 L20,11" Stroke="#64748B" StrokeThickness="1.8" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ExportDestinations}" VerticalAlignment="Center" Foreground="#334155"/>
                            <Border Style="{StaticResource ExportBadge}" Margin="16,0,0,0"><TextBlock Text="EXPORT" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11"/></Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Foreground="#64748B" FontStyle="Italic" Text="No document type yet. + New document type sets one up."
                               Visibility="{Binding DocumentTypes.Count, Converter={StaticResource CountToVis}, ConverterParameter=Empty}"/>
                    <ItemsControl ItemsSource="{Binding DocumentTypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Bare}" Click="OnOpenType" Padding="0,2"
                                                AutomationProperties.AutomationId="TypeCard" AutomationProperties.Name="{Binding Label}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#16A34A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusKind}" Value="setup"><Setter Property="Fill" Value="#F59E0B"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusKind}" Value="off"><Setter Property="Fill" Value="#94A3B8"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#475569" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Border Background="#0F172A" CornerRadius="8" Padding="10,6" Margin="0,2">
                                                        <TextBlock Text="{Binding SourceText}" Foreground="White" FontSize="12.5"/>
                                                    </Border>
                                                    <Path Data="M0,6 L18,6 M13,1 L18,6 L13,11" Stroke="#94A3B8" StrokeThickness="1.6" Margin="8,0" VerticalAlignment="Center"/>
                                                    <Border Background="#FFF7E0" CornerRadius="8" Padding="10,6" Margin="0,2">
                                                        <TextBlock Text="{Binding ProducedText}" Foreground="#7C4A03" FontSize="12.5"/>
                                                    </Border>
                                                    <Path Data="M0,6 L18,6 M13,1 L18,6 L13,11" Stroke="#94A3B8" StrokeThickness="1.6" Margin="8,0" VerticalAlignment="Center"/>
                                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,2,6,2"
                                                            Visibility="{Binding AnySharePoint, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="SharePoint" Foreground="#166534" FontSize="12.5"/>
                                                    </Border>
                                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,2,6,2"
                                                            Visibility="{Binding AnyDocuWare, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="DocuWare" Foreground="#166534" FontSize="12.5"/>
                                                    </Border>
                                                    <Border BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,2,6,2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                                <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MailState}" Value="off">
                                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding MailState}" Value="waiting">
                                                                        <Setter Property="Background" Value="#FFFBEB"/>
                                                                        <Setter Property="BorderBrush" Value="#FCD34D"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="12.5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Mail"/>
                                                                    <Setter Property="Foreground" Value="#166534"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding MailState}" Value="off">
                                                                            <Setter Property="Text" Value="Mail off"/>
                                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding MailState}" Value="waiting">
                                                                            <Setter Property="Text" Value="Mail, not connected"/>
                                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>
                                                <Path Grid.Column="2" Style="{StaticResource Chevron}" Margin="12,0,4,0"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="Remove" Style="{StaticResource QuietLink}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                Click="OnAskRemove" AutomationProperties.AutomationId="RemoveType"
                                                Visibility="{Binding ConfirmRemove, Converter={StaticResource Match}, ConverterParameter=False}"/>
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                                                Padding="12,8" Margin="0,12,0,0" Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Keep" Style="{StaticResource SmallBtn}" Margin="0,0,8,0" Click="OnKeepItem"/>
                                                    <Button Content="Remove" Style="{StaticResource DangerSmall}" Click="OnRemoveType" AutomationProperties.AutomationId="ConfirmRemoveType"/>
                                                </StackPanel>
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12.5"><Run Text="Remove "/><Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" with its companies and destinations? Nothing changes until you save."/></TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Export / one document type: its settings and its companies ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Export/type}">
                <StackPanel Margin="40,8,40,24" DataContext="{Binding SelectedDocumentType}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Content="Active" FontSize="14" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource PageTitle}"/>
                            <Border Style="{StaticResource ExportBadge}"><TextBlock Text="EXPORT" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11"/></Border>
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="DOCUMENT TYPE" Style="{StaticResource PanelTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="ID the ERP writes as documentType" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Letters and digits only. Also names the output folder."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sent to" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="10" Padding="4">
                                        <UniformGrid Columns="2">
                                            <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding IsCustomer}" GroupName="Party"><TextBlock Text="Customers" FontSize="13"/></RadioButton>
                                            <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding IsVendor}" GroupName="Party"><TextBlock Text="Vendors" FontSize="13"/></RadioButton>
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Text="Hive BDC makes" Style="{StaticResource Label}"/>
                                    <Border Background="#F1F5F9" CornerRadius="10" Padding="4">
                                        <UniformGrid Columns="2">
                                            <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding MakesEInvoice}" GroupName="Makes"><TextBlock Text="E-invoice" FontSize="13"/></RadioButton>
                                            <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding MakesPdf}" GroupName="Makes"><TextBlock Text="PDF as it is" FontSize="13"/></RadioButton>
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Text="{Binding ProducedDetail}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,26,0,12">
                        <Button DockPanel.Dock="Right" Content="+ Add company" Click="OnAddCompany" AutomationProperties.AutomationId="AddCompany"/>
                        <StackPanel>
                            <TextBlock Text="Companies" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Each company in your ERP that posts this document type. Open one to set where its documents come from and where they go." Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Foreground="#92400E" TextWrapping="Wrap" Text="No company yet. + Add company sets up the first one."
                               Visibility="{Binding Companies.Count, Converter={StaticResource CountToVis}, ConverterParameter=Empty}"/>
                    <ItemsControl ItemsSource="{Binding Companies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Bare}" Click="OnOpenCompany" Padding="0,2"
                                                AutomationProperties.AutomationId="CompanyCard" AutomationProperties.Name="{Binding TabTitle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="#F1F5F9" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DataAreaId}" FontWeight="Bold" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TabTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding SourceLine}" FontSize="12.5" Foreground="#475569" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DestinationLine}" FontSize="12.5" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Path Grid.Column="2" Style="{StaticResource Chevron}" Margin="12,0,4,0"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="Remove" Style="{StaticResource QuietLink}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                Click="OnAskRemove" AutomationProperties.AutomationId="RemoveCompany"
                                                Visibility="{Binding ConfirmRemove, Converter={StaticResource Match}, ConverterParameter=False}"/>
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                                                Padding="12,8" Margin="0,12,0,0" Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Keep" Style="{StaticResource SmallBtn}" Margin="0,0,8,0" Click="OnKeepItem"/>
                                                    <Button Content="Remove" Style="{StaticResource DangerSmall}" Click="OnRemoveCompany" AutomationProperties.AutomationId="ConfirmRemoveCompany"/>
                                                </StackPanel>
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12.5"><Run Text="Remove "/><Run Text="{Binding TabTitle, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" with its destinations? Nothing changes until you save."/></TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Export / one company: where documents come from and where they go ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Export/company}">
                <StackPanel Margin="40,8,40,24" x:Name="CompanyPage" DataContext="{Binding SelectedDocumentType.SelectedCompany}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TabTitle}" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource ExportBadge}"><TextBlock Text="EXPORT" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11"/></Border>
                    </StackPanel>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0">
                        <Run Text="Where this company's documents of the type "/><Run Text="{Binding DataContext.SelectedDocumentType.Label, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/><Run Text=" come from, and where they go."/>
                    </TextBlock>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*" MinWidth="340"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="22">
                            <StackPanel>
                                <TextBlock Text="COMES FROM" Style="{StaticResource PanelTitle}"/>
                                <Border Background="#F1F5F9" CornerRadius="10" Padding="4">
                                    <UniformGrid Columns="2">
                                        <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding IsJson}" GroupName="Source"><TextBlock Text="ERP export" FontSize="13"/></RadioButton>
                                        <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding IsWord}" GroupName="Source"><TextBlock Text="Word" FontSize="13"/></RadioButton>
                                    </UniformGrid>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Visibility="{Binding IsJson, Converter={StaticResource BoolToVis}}"
                                           Text="The ERP writes each posted document as JSON and PDF into this folder."/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Visibility="{Binding IsWord, Converter={StaticResource BoolToVis}}"
                                           Text="Invoices written in Word from the Hive BDC template. Hive BDC reads the fields and makes the PDF."/>
                                <TextBlock Text="Company in the ERP" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding DataAreaId, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/>
                                <TextBlock Text="Folder" Style="{StaticResource Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BrowseBtn}"
                                            Command="{Binding DataContext.SelectedDocumentType.BrowseInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>
                                <WrapPanel Margin="0,10,0,0" Visibility="{Binding IsWord, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Word template…" Style="{StaticResource SmallBtn}" Margin="0,0,6,4"
                                            Command="{Binding DataContext.SaveWordTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button Content="Check a Word file…" Style="{StaticResource SmallBtn}" Margin="0,0,0,4" Click="OnCheckWordFile"/>
                                </WrapPanel>
                                <Expander Header="Where the produced files are kept" Margin="0,14,0,0" Foreground="#475569" FontSize="12.5">
                                    <StackPanel Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BrowseBtn}"
                                                    Command="{Binding DataContext.SelectedDocumentType.BrowseOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Text="Empty keeps them in the folder above, under out\{type}."/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Path Grid.Column="1" Data="M4,6 L26,6 M20,0 L26,6 L20,12" Stroke="#94A3B8" StrokeThickness="1.8" VerticalAlignment="Top" Margin="2,64,0,0"/>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Panel}" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="GOES TO" Style="{StaticResource PanelTitle}"/>

                                    <Border BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="9" Background="#EEF4FF">
                                                <TextBlock Text="S" Foreground="#1D4ED8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="SharePoint" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding SharePointDetail}" Foreground="#5B6474" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Edit" Style="{StaticResource SmallBtn}" Margin="0,0,10,0" AutomationProperties.AutomationId="EditSharePointTarget"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="sharepoint"/>
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SharePointEnabled}" AutomationProperties.Name="Upload to SharePoint"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Targets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" CornerRadius="9" Background="#F0F9FF">
                                                            <TextBlock Text="D" Foreground="#0369A1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" FontSize="14"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="#5B6474" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Edit" Style="{StaticResource SmallBtn}" Margin="0,0,6,0" Click="OnEditTargetCard"
                                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            <Button Content="Remove" Style="{StaticResource QuietLink}" Margin="0,0,8,0" Click="OnAskRemove"
                                                                    Visibility="{Binding ConfirmRemove, Converter={StaticResource Match}, ConverterParameter=False}"/>
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"/>
                                                        </StackPanel>
                                                        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                                                                Padding="12,8" Margin="0,12,0,0" Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolToVis}}">
                                                            <DockPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="Keep" Style="{StaticResource SmallBtn}" Margin="0,0,8,0" Click="OnKeepItem"/>
                                                                    <Button Content="Remove" Style="{StaticResource DangerSmall}" Click="OnRemoveTargetCard"
                                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                </StackPanel>
                                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12.5"
                                                                           Text="Remove this destination? Nothing changes until you save."/>
                                                            </DockPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="9" Background="#F1F5F9">
                                                <TextBlock Text="M" Foreground="#475569" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Mail" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="To the recipient the ERP names in the document." Foreground="#5B6474" FontSize="12" TextWrapping="Wrap"/>
                                                <WrapPanel Margin="0,2,0,0"
                                                           Visibility="{Binding DataContext.MailSetUp, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Match}, ConverterParameter=False}">
                                                    <TextBlock Text="Document mail is not connected yet." Foreground="#B45309" FontSize="12" Margin="0,0,8,0"/>
                                                    <Button Content="Connect mail" Style="{StaticResource LinkBtn}" FontSize="12" Click="OnConnectMail"/>
                                                </WrapPanel>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Mail}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Send by mail"/>
                                        </Grid>
                                    </Border>

                                    <Button Style="{StaticResource AddBtn}" Click="OnAddDocuWareTarget" AutomationProperties.AutomationId="AddDocuWare"
                                            AutomationProperties.Name="Add a DocuWare file cabinet">
                                        <TextBlock Text="+ Add a DocuWare file cabinet" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                    </Button>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Export / company / SharePoint library ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Export/sharepoint}">
                <StackPanel Margin="40,8,40,24" MaxWidth="820" HorizontalAlignment="Left" DataContext="{Binding SelectedDocumentType.SelectedCompany}">
                    <TextBlock Text="SharePoint library" Style="{StaticResource PageTitle}"/>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Where each document of this company is uploaded, and what its columns say."/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SharePointEnabled}" Content="Upload to SharePoint" FontSize="14"/>
                            <TextBlock Text="Site address" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                            <TextBox Text="{Binding SiteUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="https://yourcompany.sharepoint.com/sites/Name"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Library" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Library, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Its name from the address (e.g. SalesInvoices), its display name, or the library address."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Folder (optional)" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Columns" Style="{StaticResource Label}" Margin="0,18,0,4"/>
                            <DataGrid ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" Style="{StaticResource EditGrid}" MinHeight="70" MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Column" Width="*" Binding="{Binding Column, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Template, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Add row" Command="{Binding AddColumnCommand}" Style="{StaticResource SmallBtn}" Margin="0,0,6,6"/>
                                <Button Content="Remove" Command="{Binding RemoveColumnCommand}" Style="{StaticResource SmallBtn}" Margin="0,0,6,6"/>
                                <Button Content="Import columns…" Style="{StaticResource SmallBtn}" Margin="0,0,6,6"
                                        Command="{Binding DataContext.ImportFieldTemplatesCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="Sample JSON…" Style="{StaticResource SmallBtn}" Margin="0,0,6,6"
                                        Command="{Binding DataContext.SaveFieldTemplateSampleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{}{property} takes a field of the ERP JSON, {property:date} writes a date as yyyy-MM-dd. Example: Title = {DocumentNumber}."/>
                            <Border Height="1" Background="#EEF1F5" Margin="0,18,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Test this library" Click="OnTestSharePoint"/>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Text="Uses the SharePoint connection. Uploads nothing."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Import ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Import}">
                <StackPanel Margin="40,12,40,24">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+ New import from DocuWare" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                Click="OnAddImport" Padding="16,9"/>
                        <StackPanel>
                            <TextBlock Text="Import" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Documents waiting in a document system, brought into your ERP." Foreground="#5B6474" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,16,0,18" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DocuWare" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="M0,6 L26,6 M20,1 L26,6 L20,11" Stroke="#64748B" StrokeThickness="1.8" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hive BDC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="M0,6 L26,6 M20,1 L26,6 L20,11" Stroke="#64748B" StrokeThickness="1.8" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CSV in the folder the ERP reads" VerticalAlignment="Center" Foreground="#334155"/>
                            <Path Data="M0,6 L26,6 M20,1 L26,6 L20,11" Stroke="#64748B" StrokeThickness="1.8" Margin="10,0" VerticalAlignment="Center"/>
                            <Border Background="#0F172A" CornerRadius="6" Padding="10,4"><TextBlock Text="ERP" Foreground="White" FontWeight="Bold" FontSize="12"/></Border>
                            <Border Background="#E6FFFA" CornerRadius="10" Padding="8,2" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="IMPORT" Foreground="#0F766E" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Foreground="#64748B" FontStyle="Italic" TextWrapping="Wrap"
                               Text="No import yet. + New import from DocuWare sets one up in a few steps. Connect DocuWare under Connections first."
                               Visibility="{Binding Flows.Count, Converter={StaticResource CountToVis}, ConverterParameter=Empty}"/>
                    <ItemsControl ItemsSource="{Binding Flows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                <Border Background="#E6FFFA" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="IMPORT" Foreground="#0F766E" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Foreground="#5B6474" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Edit" Style="{StaticResource SmallBtn}" Margin="0,0,6,0" Click="OnEditImportCard"/>
                                            <Button Content="Remove" Style="{StaticResource QuietLink}" Margin="0,0,8,0" Click="OnAskRemove"
                                                    Visibility="{Binding ConfirmRemove, Converter={StaticResource Match}, ConverterParameter=False}"/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"/>
                                        </StackPanel>
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                                                Padding="12,8" Margin="0,12,0,0" Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Keep" Style="{StaticResource SmallBtn}" Margin="0,0,8,0" Click="OnKeepItem"/>
                                                    <Button Content="Remove" Style="{StaticResource DangerSmall}" Click="OnRemoveImportCard" AutomationProperties.AutomationId="ConfirmRemoveImport"/>
                                                </StackPanel>
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12.5"><Run Text="Remove the import "/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="? Nothing changes until you save."/></TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Every step of every imported document is in the dashboard under View, Document history, searchable by the DocuWare document id."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Connections ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Connections}">
                <StackPanel Margin="40,12,40,24">
                    <TextBlock Text="Connections" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Sign-ins Hive BDC uses. Set each up once; export and import choose where documents go." Foreground="#5B6474" FontSize="14" Margin="0,4,0,20"/>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Panel}" Margin="0,0,12,12" Padding="20">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="44" Height="44" CornerRadius="11" Background="#EEF4FF">
                                        <TextBlock Text="S" Foreground="#1D4ED8" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SharePointAppSetUp}" Value="True"><Setter Property="Background" Value="#F0FDF4"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Not set up"/>
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SharePointAppSetUp}" Value="True">
                                                            <Setter Property="Text" Value="Set up"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="Edit" Margin="0,16,0,0" AutomationProperties.AutomationId="EditSharePointApp"
                                        Command="{Binding OpenCommand}" CommandParameter="sharepoint-app"/>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="SharePoint" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SharePointAppDetail}" Style="{StaticResource Hint}" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Margin="0,0,12,12" Padding="20">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="44" Height="44" CornerRadius="11" Background="#F0F9FF">
                                        <TextBlock Text="D" Foreground="#0369A1" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DocuWareSetUp}" Value="True"><Setter Property="Background" Value="#F0FDF4"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Not set up"/>
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DocuWareSetUp}" Value="True">
                                                            <Setter Property="Text" Value="Set up"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="Edit" Margin="0,16,0,0" AutomationProperties.AutomationId="EditDocuWare"
                                        Command="{Binding OpenCommand}" CommandParameter="docuware"/>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="DocuWare" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DocuWareDetail}" Style="{StaticResource Hint}" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="20">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="44" Height="44" CornerRadius="11" Background="#F1F5F9">
                                        <TextBlock Text="M" Foreground="#475569" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MailSetUp}" Value="True"><Setter Property="Background" Value="#F0FDF4"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Not set up"/>
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MailSetUp}" Value="True">
                                                            <Setter Property="Text" Value="Set up"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="Edit" Margin="0,16,0,0" AutomationProperties.AutomationId="EditMail"
                                        Command="{Binding OpenCommand}" CommandParameter="mail"/>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Document mail" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MailDetail}" Style="{StaticResource Hint}" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Passwords and secrets are stored encrypted on this machine when you save, and never shown again. Leave a password field empty to keep the stored one."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Connections / SharePoint ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Connections/sharepoint-app}">
                <StackPanel Margin="40,8,40,24" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="SharePoint" Style="{StaticResource PageTitle}"/>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="The Microsoft 365 app your IT registered for Hive BDC. One app serves every library."/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Tenant ID" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Client ID" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Client secret" Style="{StaticResource Label}"/>
                            <PasswordBox x:Name="SecretBox"/>
                            <TextBlock Text="{Binding SecretPlaceholderHint}" Style="{StaticResource Hint}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                       Text="Application permission Sites.ReadWrite.All or Sites.Selected. To test it, open a company's SharePoint library under Export and use Test this library."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Connections / Document mail ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Connections/mail}">
                <StackPanel Margin="40,8,40,24" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="Document mail" Style="{StaticResource PageTitle}"/>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Sends each produced document through Microsoft 365, with its own app (application permission Mail.Send)."/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MailEnabled}" Content="Send document mails" FontSize="14"/>
                            <StackPanel IsEnabled="{Binding MailEnabled}">
                                <TextBlock Text="Send from" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                                <TextBox Text="{Binding MailFrom, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="The mailbox documents are sent as, e.g. invoices@yourcompany.com."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Client ID" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding MailClientId, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Client secret" Style="{StaticResource Label}"/>
                                        <PasswordBox x:Name="MailSecretBox"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding MailSecretPlaceholderHint}" Style="{StaticResource Hint}"/>
                                <TextBlock Text="Tenant ID (empty: the same as SharePoint)" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding MailTenantId, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Test recipients" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding MailRedirectTo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextWrapping="NoWrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Documents from a test or development ERP go here instead of to the customer or vendor. Separate with ; or one per line."/>
                                <CheckBox Content="Keep a copy in the sender's Sent Items" Margin="0,12,0,0" IsChecked="{Binding MailSaveToSentItems}"/>
                                <Border Height="1" Background="#EEF1F5" Margin="0,18,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Test mail" Click="OnTestMail"/>
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" Text="Checks the app and the mailbox. Sends nothing."/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Connections / DocuWare ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Connections/docuware}">
                <StackPanel Margin="40,8,40,24" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="DocuWare" Style="{StaticResource PageTitle}"/>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" Text="Three things, then Hive BDC checks the sign-in."/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="1   Address of your DocuWare" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DocuWareUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Copy it from the browser when DocuWare is open, e.g. https://yourcompany.docuware.cloud."/>
                            <TextBlock Text="2   Integration user" FontWeight="SemiBold" Margin="0,20,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="User name" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DocuWareUserName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="DocuWareSecretBox"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding DocuWareSecretHint}" Style="{StaticResource Hint}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="A user allowed to sign in with a DocuWare password. Ask your DocuWare administrator for one."/>
                            <TextBlock Text="3   Check" FontWeight="SemiBold" Margin="0,20,0,6"/>
                            <Button Content="Test connection" HorizontalAlignment="Left" Click="OnTestDocuWare"/>
                            <Border CornerRadius="10" Padding="12" Margin="0,10,0,0"
                                    Visibility="{Binding DocuWareStatus, Converter={StaticResource Match}, ConverterParameter=!}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DocuWareStatusIsError}" Value="True"><Setter Property="Background" Value="#FEF2F2"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DocuWareStatus}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#166534"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DocuWareStatusIsError}" Value="True"><Setter Property="Foreground" Value="#B91C1C"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Service ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Service}">
                <StackPanel Margin="40,12,40,24" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Service" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="How the Hive BDC service runs on this machine." Foreground="#5B6474" FontSize="14" Margin="0,4,0,20"/>
                    <Border Style="{StaticResource Panel}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Check for new documents every" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="80" Text="{Binding PollSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="seconds (at least 5)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#475569"/>
                            </StackPanel>
                            <TextBlock Text="Log folder" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding LogDir, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BrowseBtn}" Command="{Binding BrowseLogDirCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="Empty keeps the logs in %ProgramData%\HiveBDC\logs, one file per day."/>
                            <TextBlock Text="Licence" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0"
                                       Text="Managed on the dashboard with Renew licence: import the .lic file Balsoft sent you. Without a valid licence, or 7 days after it expired, processing stops."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Footer ══ -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="40,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                               Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrush}}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Discard" Click="OnCancel" Margin="0,0,8,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Save changes" Click="OnSave" Style="{StaticResource PrimaryButton}" Padding="18,7"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>