<Window x:Class="Balsoft.Hive.BDC.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Balsoft.Hive.BDC.App.Converters"
        xmlns:vm="clr-namespace:Balsoft.Hive.BDC.App.ViewModels"
        Title="Hive BDC — Settings" Height="800" Width="1100"
        MinHeight="480" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/hive-bdc-logo.png"
        FontFamily="Segoe UI, Tahoma"
        Background="{StaticResource AppBg}">

    <Window.Resources>
        <Style x:Key="BrowseBtn" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Document types: choice tiles, company chips, destination rows, step headers -->
        <Style x:Key="ChoiceTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tile" Background="White" BorderBrush="#D3D9E1" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tile" Property="BorderBrush" Value="#FCB608"/>
                                <Setter TargetName="tile" Property="Background" Value="#FFFBEB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="BorderBrush" Value="#F59E0B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        <Style x:Key="DestRow" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="DestName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CompanyChips" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="chip" Margin="0,0,8,8" Padding="12,6" CornerRadius="16" BorderThickness="1.5"
                                            BorderBrush="#D3D9E1" Background="White" MaxWidth="300">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="chip" Property="Background" Value="#FFFBEB"/>
                                            <Setter TargetName="chip" Property="BorderBrush" Value="#FCB608"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="EditGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinRowHeight" Value="32"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style x:Key="MasterList" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <!-- Flat tabs in the app's palette: a text header with a brand underline when selected. -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="16,10" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="applied live on Save, no restart" FontSize="12" Foreground="#93A3BC"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Footer: status (trims) + actions -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                           Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrush}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Test SharePoint" Click="OnTestSharePoint" Margin="0,0,8,0"
                            ToolTip="Test the selected company entry's SharePoint target with the SharePoint app from Connections"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Test mail" Click="OnTestMail" Margin="0,0,8,0"
                            ToolTip="Check the mail app registration and sender mailbox — sends nothing"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Save" Click="OnSave" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Validation errors (any tab) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" BorderBrush="#FCA5A5" Background="#FEF2F2"
                Visibility="{Binding ValidationErrors.Count, Converter={StaticResource CountToVis}}">
            <StackPanel>
                <TextBlock Text="PLEASE FIX" Style="{StaticResource CardTitle}" Foreground="#B91C1C"/>
                <ItemsControl ItemsSource="{Binding ValidationErrors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#B91C1C" FontSize="12" Margin="0,1" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Import notes: what the last field template import could not place -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" BorderBrush="#93C5FD" Background="#EFF6FF"
                Visibility="{Binding ImportNotes.Count, Converter={StaticResource CountToVis}}">
            <StackPanel>
                <TextBlock Text="IMPORT" Style="{StaticResource CardTitle}" Foreground="#1D4ED8"/>
                <ItemsControl ItemsSource="{Binding ImportNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#1E3A8A" FontSize="12" Margin="0,1" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TabControl Margin="12,4,12,0">

            <!-- ── 1. Document types: what flows, and for which companies from where to where ── -->
            <TabItem Header="Document types">
                <Grid Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Master: type list -->
                    <DockPanel Grid.Column="0" Margin="0,0,12,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Add type" Command="{Binding AddDocumentTypeCommand}" Padding="12,4" Margin="0,0,6,0"/>
                            <Button Content="Remove" Command="{Binding RemoveDocumentTypeCommand}" Padding="12,4"
                                    IsEnabled="{Binding HasDocumentTypeSelection}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="Each type lists the companies it is picked up for. A type the ERP sends that is not here is added automatically, routed like the folder it arrived in, and marked auto-registered. A built-in type you remove stays removed; its files go to the error folder."/>
                        <ListBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedDocumentType}"
                                 Style="{StaticResource MasterList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="#9CA3AF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Detail: the selected type -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding HasDocumentTypeSelection}"
                                  DataContext="{Binding SelectedDocumentType}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="DOCUMENT TYPE" Style="{StaticResource CardTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Display name" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="ID (documentType in the ERP JSON)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Letters and digits only. Also names the output sub-folder and the ledger entry."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Sent to" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{x:Static vm:DocumentTypeEditViewModel.Parties}"
                                                      SelectedItem="{Binding Party}" Width="160" HorizontalAlignment="Left"/>
                                            <TextBlock Text="Produced as" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{x:Static vm:DocumentTypeEditViewModel.HandlerChoices}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Handler}" Width="280" HorizontalAlignment="Left"/>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="An e-invoice is written from the document's data (sales invoices); any other document goes out as the PDF the ERP made."/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,0,20,0"/>
                                        <CheckBox Content="Mail to the recipient" IsChecked="{Binding Mail}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Mail uses the connection from the Connections tab; recipient, subject and body come from the ERP JSON. A disabled type's files go to the error folder."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="COMPANIES" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,10"
                                               Text="One entry per ERP company this type is picked up for. Choose a company to set where its documents come from and where they go."/>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="+ Add company" Command="{Binding AddCompanyRowCommand}" Padding="12,5" Margin="0,0,6,0"/>
                                            <Button Content="Remove company" Command="{Binding RemoveCompanyCommand}" Padding="12,5"
                                                    IsEnabled="{Binding HasCompanySelection}"/>
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}" Style="{StaticResource CompanyChips}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Summary}" Foreground="#6B7280" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                    <TextBlock Margin="0,4,0,0" Foreground="#6B7280" FontStyle="Italic" TextWrapping="Wrap"
                                               Text="No company yet. + Add company sets up where this type's documents come from."
                                               Visibility="{Binding Companies.Count, Converter={StaticResource CountToVis}, ConverterParameter=Empty}"/>

                                    <!-- The chosen company entry -->
                                    <StackPanel DataContext="{Binding SelectedCompany}" Margin="0,6,0,0"
                                                Visibility="{Binding DataContext.HasCompanySelection, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Company (ERP dataAreaId)" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,10,0"/>
                                            <TextBox Width="160" Text="{Binding DataAreaId, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <TextBlock Text="1   Where the documents come from" Style="{StaticResource StepHeader}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton Grid.Column="0" Style="{StaticResource ChoiceTile}" IsChecked="{Binding IsJson}">
                                                <StackPanel>
                                                    <TextBlock Text="ERP export: JSON + PDF" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,3,0,0"
                                                               Text="AX or Dynamics 365 writes each posted document as a JSON file and its PDF into a folder."/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton Grid.Column="1" Style="{StaticResource ChoiceTile}" IsChecked="{Binding IsWord}" Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="Word documents" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,3,0,0"
                                                               Text="Invoices written in Word from the Hive BDC template. Hive BDC reads the fields and makes the PDF."/>
                                                </StackPanel>
                                            </RadioButton>
                                        </Grid>
                                        <TextBlock Text="Folder" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BrowseBtn}"
                                                    Command="{Binding DataContext.BrowseInputCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Visibility="{Binding IsJson, Converter={StaticResource BoolToVis}}"
                                                   Text="A local folder or a network share. Several types may share one folder; the JSON says which type it is."/>
                                        <StackPanel Visibility="{Binding IsWord, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Every .docx is read once it is closed. A PDF with the same name next to it is used instead of the one Hive BDC makes."/>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Content="Word template…" Padding="10,3" Margin="0,0,6,4"
                                                        Command="{Binding DataContext.SaveWordTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="Save the Hive BDC Word invoice template: every field a content control tagged with its BT number"/>
                                                <Button Content="Check a Word file…" Padding="10,3" Margin="0,0,0,4" Click="OnCheckWordFile"
                                                        ToolTip="Open a filled .docx and see what Hive BDC reads from it, before it goes into the folder"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Expander Header="More: where the produced files are kept" Margin="0,8,0,0" Foreground="#475569">
                                            <StackPanel Margin="0,4,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BrowseBtn}"
                                                            Command="{Binding DataContext.BrowseOutputCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Hint}" Text="Blank keeps them in the folder above, under out\{type}."/>
                                            </StackPanel>
                                        </Expander>

                                        <TextBlock Text="2   What is made" Style="{StaticResource StepHeader}"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#334155">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="The PDF the ERP made, as it is. Change it under Produced as above."/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Handler, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="EInvoice">
                                                            <Setter Property="Text" Value="An e-invoice: XRechnung or ZUGFeRD, as each document says. Change it under Produced as above."/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="3   Where they go" Style="{StaticResource StepHeader}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,8"
                                                   Text="Every document goes to each place that is switched on, in this order. Switching one off keeps its settings."/>

                                        <!-- SharePoint -->
                                        <Border Style="{StaticResource DestRow}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="SharePoint" Style="{StaticResource DestName}"/>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Test" Click="OnTestSharePoint" Padding="10,3" Margin="0,0,10,0"
                                                                Visibility="{Binding SharePointEnabled, Converter={StaticResource BoolToVis}}"/>
                                                        <CheckBox Content="On" IsChecked="{Binding SharePointEnabled}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,10,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Off. Switch on to upload every document to a SharePoint library."/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SharePointEnabled}" Value="True">
                                                                        <Setter Property="Text" Value="Each document is uploaded to the library below, with its columns filled."/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>
                                                <StackPanel Margin="0,10,0,0" Visibility="{Binding SharePointEnabled, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Site address" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox Text="{Binding SiteUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Style="{StaticResource Hint}" Text="https://yourcompany.sharepoint.com/sites/Name"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="Library" Style="{StaticResource FieldLabel}"/>
                                                            <TextBox Text="{Binding Library, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Style="{StaticResource Hint}"
                                                                       Text="The name from the library's address (e.g. SalesInvoices) or its display name; a pasted library address works too."/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <TextBlock Text="Folder (optional)" Style="{StaticResource FieldLabel}"/>
                                                            <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="Columns (SharePoint column → value)" Foreground="#6B7280" FontSize="12" Margin="0,12,0,4"/>
                                                    <DataGrid ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}"
                                                              Style="{StaticResource EditGrid}" MinHeight="70" MaxHeight="180">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Column" Width="*" Binding="{Binding Column, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Template, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Button Content="Add row" Command="{Binding AddColumnCommand}" Padding="10,3" Margin="0,0,6,4"/>
                                                        <Button Content="Remove" Command="{Binding RemoveColumnCommand}" Padding="10,3" Margin="0,0,6,4"/>
                                                        <Button Content="Sample JSON…" Padding="10,3" Margin="0,0,6,4"
                                                                Command="{Binding DataContext.SaveFieldTemplateSampleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Save a HiveBDC.SharePointFields JSON file for THIS type and company: the current target and columns, examples where empty. Edit it, then use Import columns…"/>
                                                        <Button Content="Import columns…" Padding="10,3" Margin="0,0,0,4"
                                                                Command="{Binding DataContext.ImportFieldTemplatesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Import the SharePoint target and column templates for THIS type and company from a HiveBDC.SharePointFields JSON file. Review, then Save."/>
                                                    </WrapPanel>
                                                    <TextBlock Style="{StaticResource Hint}"
                                                               Text="{}{property} takes any field of the ERP JSON, {property:date} writes a date as yyyy-MM-dd. Example: Title = {DocumentNumber}."/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- DocuWare and other targets -->
                                        <ItemsControl ItemsSource="{Binding Targets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource DestRow}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DestName}" Text="{Binding KindLabel}"/>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="Edit…" Click="OnEditTargetCard" Padding="10,3" Margin="0,0,6,0"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                <Button Content="Remove" Click="OnRemoveTargetCard" Padding="10,3" Margin="0,0,10,0"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                <CheckBox Content="On" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detail}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,10,0"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Click="OnAddDocuWareTarget" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,8" Margin="0,0,0,8"
                                                Background="Transparent" BorderBrush="#CBD5E1" Cursor="Hand"
                                                ToolTip="Store every document of this type and company in a DocuWare file cabinet. Set up the DocuWare sign-in on the Connections tab first.">
                                            <TextBlock Text="+ Add a DocuWare file cabinet" Foreground="#2563EB" FontWeight="SemiBold"/>
                                        </Button>

                                        <!-- Mail -->
                                        <Border Style="{StaticResource DestRow}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="Mail" Style="{StaticResource DestName}"/>
                                                <CheckBox DockPanel.Dock="Right" Content="On" VerticalAlignment="Center"
                                                          IsChecked="{Binding DataContext.Mail, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,10,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Last, to the recipient the ERP names in the document. For every company of this type."/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.MailEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                    <Setter Property="Text" Value="Document mail is switched off on the Connections tab, so nothing is mailed yet. For every company of this type."/>
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── 2. Connections: SharePoint app + mail ───────────────────────────── -->
            <TabItem Header="Connections">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="SHAREPOINT APP" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,8"
                                           Text="One app registration uploads for every document type and company. Which library each document goes to is set per company entry on the Document types tab."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Client secret" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="SecretBox"/>
                                        <TextBlock Text="{Binding SecretPlaceholderHint}" Style="{StaticResource Hint}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                   Text="Application permission Sites.ReadWrite.All (or Sites.Selected). The secret is stored encrypted on this machine."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="DOCUMENT MAIL" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <CheckBox Content="Enabled" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MailEnabled}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                                           Text="Mails each produced document via Microsoft Graph with its own app registration (application permission Mail.Send). Recipients, subject and body come from the ERP JSON. Switch mail off per type on the Document types tab."/>
                                <Grid IsEnabled="{Binding MailEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding MailClientId, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Client secret" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="MailSecretBox"/>
                                        <TextBlock Text="{Binding MailSecretPlaceholderHint}" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="Tenant ID (blank = same as SharePoint)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding MailTenantId, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Send from" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding MailFrom, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="The mailbox documents are sent as, e.g. rechnung@example.de."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Test recipients (separate with ; or one per line)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding MailRedirectTo, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="NoWrap" Height="118"
                                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                   Text="Documents exported from a Test or Dev AX go here instead of to the customer or vendor, with the real recipients named in the body. Only a Live AX reaches real recipients."/>
                                        <CheckBox Content="Keep a copy in the sender's Sent Items" Margin="0,10,0,0" IsChecked="{Binding MailSaveToSentItems}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,10">
                            <StackPanel>
                                <TextBlock Text="DOCUWARE" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,8"
                                           Text="Sign-in for storing documents in DocuWare. Which file cabinet a document goes to is set per company entry on the Document types tab (Also deliver to)."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="DocuWare address" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DocuWareUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="For example https://yourcompany.docuware.cloud. The address from the browser works too."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="User name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DocuWareUserName, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="DocuWareSecretBox"/>
                                        <TextBlock Text="{Binding DocuWareSecretHint}" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Test connection" Click="OnTestDocuWare" Padding="12,4"/>
                                    <TextBlock Text="{Binding DocuWareStatus}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#15803D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DocuWareStatusIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="The DocuWare user must be allowed to sign in with a DocuWare password. A user that may only sign in with Microsoft is refused; ask the DocuWare administrator for an integration user."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 3. Service: poll, logs, licence ────────────────────────────────── -->
            <TabItem Header="Imports">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="IMPORT INTO THE ERP" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,8"
                                           Text="Documents that are ready in DocuWare become a CSV file in the folder the ERP reads, then get marked as imported in DocuWare. Set up the DocuWare sign-in on the Connections tab first."/>
                                <TextBlock Foreground="#6B7280" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="No import yet. Add import from DocuWare… sets one up in a few steps."
                                           Visibility="{Binding Flows.Count, Converter={StaticResource CountToVis}, ConverterParameter=Empty}"/>
                                <ListBox ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow}" MinHeight="80" MouseDoubleClick="OnEditImport"
                                         Visibility="{Binding Flows.Count, Converter={StaticResource CountToVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Summary}" Foreground="#6B7280" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Add import from DocuWare…" Click="OnAddImport" Padding="10,3" Margin="0,0,6,4"/>
                                    <Button Content="Edit…" Click="OnEditImport" Padding="10,3" Margin="0,0,6,4"/>
                                    <Button Content="Remove" Command="{Binding RemoveFlowCommand}" Padding="10,3" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Every step of every imported document is in View > Document history, searchable by the DocuWare document id."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Service">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,8">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="SERVICE" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Poll seconds" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="90" HorizontalAlignment="Left" Text="{Binding PollSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="How often every input folder is scanned. Minimum 5."/>

                            <TextBlock Text="Log folder" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding LogDir, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BrowseBtn}" Command="{Binding BrowseLogDirCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="Blank = %ProgramData%\HiveBDC\logs. Rolling daily files, 31 kept."/>

                            <TextBlock Text="License" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Managed from the dashboard: use Renew license… to import the .lic Balsoft sent you. A valid license is always required; without one, or once it expires past the 7-day grace period, processing stops. The license lists features: e-invoice generation and PDF document dispatch are unlocked separately."/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
