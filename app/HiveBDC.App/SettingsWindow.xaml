                        </StackPanel>
                    </DockPanel>
                    <TextBlock Foreground="#92400E" TextWrapping="Wrap" Text="No company yet. + Add company sets up the first one."
                               Visibility="{Binding Companies.Count, Converter={StaticResource CountToVis}, ConverterParameter=Empty}"/>
                    <ItemsControl ItemsSource="{Binding Companies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Bare}" Click="OnOpenCompany" Padding="0,2"
                                                AutomationProperties.AutomationId="CompanyCard" AutomationProperties.Name="{Binding TabTitle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="#F1F5F9" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DataAreaId}" FontWeight="Bold" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TabTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                        <Border Background="#F1F5F9" CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding Enabled, Converter={StaticResource Match}, ConverterParameter=False}">
                                                            <TextBlock Text="Off" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SourceLine}" FontSize="12.5" Foreground="#475569" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DestinationLine}" FontSize="12.5" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Path Grid.Column="2" Style="{StaticResource Chevron}" Margin="12,0,4,0"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="Remove" Style="{StaticResource QuietLink}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                Click="OnAskRemove" AutomationProperties.AutomationId="RemoveCompany"
                                                Visibility="{Binding ConfirmRemove, Converter={StaticResource Match}, ConverterParameter=False}"/>
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                                                Padding="12,8" Margin="0,12,0,0" Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Keep" Style="{StaticResource SmallBtn}" Margin="0,0,8,0" Click="OnKeepItem"/>
                                                    <Button Content="Remove" Style="{StaticResource DangerSmall}" Click="OnRemoveCompany" AutomationProperties.AutomationId="ConfirmRemoveCompany"/>
                                                </StackPanel>
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12.5"><Run Text="Remove "/><Run Text="{Binding TabTitle, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" with its destinations? Nothing changes until you save."/></TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Outbound / one company: where documents come from and where they go ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/company}">
                <StackPanel Margin="40,8,40,24" x:Name="CompanyPage" DataContext="{Binding SelectedDocumentType.SelectedCompany}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Content="Active" FontSize="14" VerticalAlignment="Center"
                                  AutomationProperties.Name="Company active"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TabTitle}" Style="{StaticResource PageTitle}"/>
                            <Border Style="{StaticResource ExportBadge}"><TextBlock Text="OUTBOUND" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11"/></Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0">
                        <Run Text="Where this company's documents of the type "/><Run Text="{Binding DataContext.SelectedDocumentType.Label, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/><Run Text=" come from, and where they go."/>
                    </TextBlock>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*" MinWidth="340"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="22">
                            <StackPanel>
                                <TextBlock Text="COMES FROM" Style="{StaticResource PanelTitle}"/>
                                <Border Background="#F1F5F9" CornerRadius="10" Padding="4">
                                    <UniformGrid Columns="2">
                                        <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding IsJson}" GroupName="Source"><TextBlock Text="ERP export" FontSize="13"/></RadioButton>
                                        <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding IsWord}" GroupName="Source"><TextBlock Text="Word" FontSize="13"/></RadioButton>
                                    </UniformGrid>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Visibility="{Binding IsJson, Converter={StaticResource BoolToVis}}"
                                           Text="The ERP writes each posted document as JSON and PDF into this folder."/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Visibility="{Binding IsWord, Converter={StaticResource BoolToVis}}"
                                           Text="Invoices written in Word from the Hive BDC template. Hive BDC reads the fields and makes the PDF."/>
                                <TextBlock Text="Company in the ERP" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding DataAreaId, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/>
                                <TextBlock Text="Folder" Style="{StaticResource Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BrowseBtn}"
                                            Command="{Binding DataContext.SelectedDocumentType.BrowseInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>
                                <WrapPanel Margin="0,10,0,0" Visibility="{Binding IsWord, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Word template…" Style="{StaticResource SmallBtn}" Margin="0,0,6,4"
                                            Command="{Binding DataContext.SaveWordTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button Content="Check a Word file…" Style="{StaticResource SmallBtn}" Margin="0,0,0,4" Click="OnCheckWordFile"/>
                                </WrapPanel>
                                <Expander Header="Where the produced files are kept" Margin="0,14,0,0" Foreground="#475569" FontSize="12.5">
                                    <StackPanel Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BrowseBtn}"
                                                    Command="{Binding DataContext.SelectedDocumentType.BrowseOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Text="Empty keeps them in the folder above, under out\{type}."/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Path Grid.Column="1" Data="M4,6 L26,6 M20,0 L26,6 L20,12" Stroke="#94A3B8" StrokeThickness="1.8" VerticalAlignment="Top" Margin="2,64,0,0"/>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Panel}" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="GOES TO" Style="{StaticResource PanelTitle}"/>

                                    <Border BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="9" Background="#EEF4FF">
                                                <TextBlock Text="S" Foreground="#1D4ED8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="SharePoint" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding SharePointDetail}" Foreground="#5B6474" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Edit" Style="{StaticResource SmallBtn}" Margin="0,0,10,0" AutomationProperties.AutomationId="EditSharePointTarget"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="sharepoint"/>
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SharePointEnabled}" AutomationProperties.Name="Upload to SharePoint"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Targets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" CornerRadius="9" Background="#F0F9FF">
                                                            <TextBlock Text="D" Foreground="#0369A1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" FontSize="14"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="#5B6474" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Edit" Style="{StaticResource SmallBtn}" Margin="0,0,6,0" Click="OnEditTargetCard"
                                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            <Button Content="Remove" Style="{StaticResource QuietLink}" Margin="0,0,8,0" Click="OnAskRemove"
                                                                    Visibility="{Binding ConfirmRemove, Converter={StaticResource Match}, ConverterParameter=False}"/>
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"/>
                                                        </StackPanel>
                                                        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                                                                Padding="12,8" Margin="0,12,0,0" Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolToVis}}">
                                                            <DockPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="Keep" Style="{StaticResource SmallBtn}" Margin="0,0,8,0" Click="OnKeepItem"/>
                                                                    <Button Content="Remove" Style="{StaticResource DangerSmall}" Click="OnRemoveTargetCard"
                                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                </StackPanel>
                                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12.5"
                                                                           Text="Remove this destination? Nothing changes until you save."/>
                                                            </DockPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="9" Background="#F1F5F9">
                                                <TextBlock Text="M" Foreground="#475569" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Mail" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="To the recipient the ERP names in the document." Foreground="#5B6474" FontSize="12" TextWrapping="Wrap"/>
                                                <WrapPanel Margin="0,2,0,0"
                                                           Visibility="{Binding DataContext.MailSetUp, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Match}, ConverterParameter=False}">
                                                    <TextBlock Text="Document mail is not connected yet." Foreground="#B45309" FontSize="12" Margin="0,0,8,0"/>
                                                    <Button Content="Connect mail" Style="{StaticResource LinkBtn}" FontSize="12" Click="OnConnectMail"/>
                                                </WrapPanel>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Mail}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Send by mail"/>
                                        </Grid>
                                    </Border>

                                    <Button Style="{StaticResource AddBtn}" AutomationProperties.AutomationId="AddDestination" AutomationProperties.Name="Add a destination"
                                            Command="{Binding DataContext.AddDestinationCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="+ Add a destination" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                    </Button>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Outbound / company / SharePoint library ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/sharepoint}">
                <StackPanel Margin="40,8,40,24" MaxWidth="820" HorizontalAlignment="Left" DataContext="{Binding SelectedDocumentType.SelectedCompany}">
                    <TextBlock Text="SharePoint library" Style="{StaticResource PageTitle}"/>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Where each document of this company is uploaded, and what its columns say."/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SharePointEnabled}" Content="Upload to SharePoint" FontSize="14"/>
                            <TextBlock Text="Site address" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                            <TextBox Text="{Binding SiteUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="https://yourcompany.sharepoint.com/sites/Name"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Library" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Library, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Its name from the address (e.g. SalesInvoices), its display name, or the library address."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Folder (optional)" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Columns" Style="{StaticResource Label}" Margin="0,18,0,4"/>
                            <DataGrid ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" Style="{StaticResource EditGrid}" MinHeight="70" MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Column" Width="*" Binding="{Binding Column, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Template, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Add row" Command="{Binding AddColumnCommand}" Style="{StaticResource SmallBtn}" Margin="0,0,6,6"/>
                                <Button Content="Remove" Command="{Binding RemoveColumnCommand}" Style="{StaticResource SmallBtn}" Margin="0,0,6,6"/>
                                <Button Content="Import columns…" Style="{StaticResource SmallBtn}" Margin="0,0,6,6"
                                        Command="{Binding DataContext.ImportFieldTemplatesCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="Sample JSON…" Style="{StaticResource SmallBtn}" Margin="0,0,6,6"
                                        Command="{Binding DataContext.SaveFieldTemplateSampleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{}{property} takes a field of the ERP JSON, {property:date} writes a date as yyyy-MM-dd. Example: Title = {DocumentNumber}."/>
                            <Border Height="1" Background="#EEF1F5" Margin="0,18,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Test this library" Click="OnTestSharePoint"/>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Text="Uses the SharePoint connection. Uploads nothing."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Outbound / company / add a destination: one tile per destination kind the service has ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/pick-destination}">
                <StackPanel Margin="40,8,40,24">
                    <TextBlock Text="Where should the documents go?" Style="{StaticResource PageTitle}"/>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,18" TextWrapping="Wrap"
                               Text="Choose the destination. Its own settings follow on the next screen. Mail is a switch on the company itself."/>
                    <ItemsControl ItemsSource="{Binding Destinations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Bare}" Click="OnPickDestination" Margin="0,0,14,14"
                                        AutomationProperties.AutomationId="DestinationTile" AutomationProperties.Name="{Binding Name}">
                                    <Border Style="{StaticResource ListCard}" Margin="0" Padding="20">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border Width="44" Height="44" CornerRadius="11" Background="#EEF4FF">
                                                    <TextBlock Text="{Binding Initial}" Foreground="#1D4ED8" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFFBEB"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Background" Value="#F0FDF4"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Connect first"/>
                                                                <Setter Property="Foreground" Value="#92400E"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                                                        <Setter Property="Text" Value="Connected"/>
                                                                        <Setter Property="Foreground" Value="#166534"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" FontSize="13" Height="56"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="20,14" HorizontalAlignment="Left" Width="320">
                        <StackPanel>
                            <TextBlock Text="More destinations" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Further destinations appear here when a Hive BDC update brings their connector."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Outbound / company / one destination: its settings and what its fields say ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Outbound/destination}">
                <StackPanel Margin="40,8,40,24" MaxWidth="980" HorizontalAlignment="Left" DataContext="{Binding OpenDestination}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Content="Active" FontSize="14" VerticalAlignment="Center"
                                  AutomationProperties.Name="Destination active"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                            <Border Style="{StaticResource ExportBadge}"><TextBlock Text="OUTBOUND" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11"/></Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" Style="{StaticResource PanelTitle}"/>
                            <ItemsControl ItemsSource="{Binding Settings}" ItemTemplate="{StaticResource SourceSettingTemplate}" Margin="0,-12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="22" Visibility="{Binding HasFields, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="WHAT THE FIELDS SAY" Style="{StaticResource PanelTitle}"/>
                            <DataGrid ItemsSource="{Binding Fields}" Style="{StaticResource EditGrid}" MinHeight="70" MaxHeight="420" AutomationProperties.AutomationId="DestinationFields">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Field" Width="1.2*" Binding="{Binding Label}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Kind" Width="0.8*" Binding="{Binding Kind}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Value from the document" Width="1.4*" Binding="{Binding Template, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Hint}" Text="{}{property} takes a value of the ERP JSON, {property:date} writes a date. Example: {DocumentNumber}."/>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12.5"
                                       Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrush}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Connections / a kind without a page of its own ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Connections/conn}">
                <StackPanel Margin="40,8,40,24" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding OpenConnection.Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding OpenConnection.Kind.Description}" Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding OpenConnection.Settings}" ItemTemplate="{StaticResource SourceSettingTemplate}" Margin="0,-12,0,0"/>
                            <TextBlock Text="{Binding OpenConnection.SecretLabel}" Style="{StaticResource Label}"/>
                            <PasswordBox x:Name="ConnectionSecretBox" AutomationProperties.Name="Connection secret"/>
                            <TextBlock Text="{Binding OpenConnection.SecretHint}" Style="{StaticResource Hint}"/>
                            <Border Height="1" Background="#EEF1F5" Margin="0,18,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Test connection" Click="OnTestConnection" AutomationProperties.AutomationId="TestGenericConnection"/>
                            </StackPanel>
                            <TextBlock Text="{Binding OpenConnection.StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12.5"
                                       Foreground="{Binding OpenConnection.StatusIsError, Converter={StaticResource StatusBrush}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Inbound: the document types brought into the ERP ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Inbound}">
                <StackPanel Margin="40,12,40,24">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+ New document type" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                Command="{Binding NewInboundTypeCommand}" Padding="16,9" AutomationProperties.AutomationId="NewInboundType"/>
                        <StackPanel>
                            <TextBlock Text="Inbound" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Documents waiting in a document system, brought into your ERP. Open a document type to set it up." Foreground="#5B6474" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,16,0,18" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Document system" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="M0,6 L26,6 M20,1 L26,6 L20,11" Stroke="#64748B" StrokeThickness="1.8" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hive BDC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="M0,6 L26,6 M20,1 L26,6 L20,11" Stroke="#64748B" StrokeThickness="1.8" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CSV in the folder the ERP reads" VerticalAlignment="Center" Foreground="#334155"/>
                            <Path Data="M0,6 L26,6 M20,1 L26,6 L20,11" Stroke="#64748B" StrokeThickness="1.8" Margin="10,0" VerticalAlignment="Center"/>
                            <Border Background="#0F172A" CornerRadius="6" Padding="10,4"><TextBlock Text="ERP" Foreground="White" FontWeight="Bold" FontSize="12"/></Border>
                            <Border Style="{StaticResource InboundBadge}" Margin="16,0,0,0"><TextBlock Text="INBOUND" Foreground="#0F766E" FontWeight="Bold" FontSize="11"/></Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Foreground="#64748B" FontStyle="Italic" TextWrapping="Wrap"
                               Text="No inbound document type yet. + New document type sets one up: its companies, where their documents come from and the folder the ERP reads."
                               Visibility="{Binding InboundTypes.Count, Converter={StaticResource CountToVis}, ConverterParameter=Empty}"/>
                    <ItemsControl ItemsSource="{Binding InboundTypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Bare}" Click="OnOpenInboundType" Padding="0,2"
                                                AutomationProperties.AutomationId="InboundTypeCard" AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#16A34A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusKind}" Value="setup"><Setter Property="Fill" Value="#F59E0B"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusKind}" Value="off"><Setter Property="Fill" Value="#94A3B8"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#475569" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Border Background="#F0F9FF" CornerRadius="8" Padding="10,6" Margin="0,2"
                                                            Visibility="{Binding SystemsText, Converter={StaticResource Match}, ConverterParameter=!}">
                                                        <TextBlock Text="{Binding SystemsText}" Foreground="#075985" FontSize="12.5"/>
                                                    </Border>
                                                    <Path Data="M0,6 L18,6 M13,1 L18,6 L13,11" Stroke="#94A3B8" StrokeThickness="1.6" Margin="8,0" VerticalAlignment="Center"/>
                                                    <Border Background="#FFF7E0" CornerRadius="8" Padding="10,6" Margin="0,2">
                                                        <TextBlock Text="CSV" Foreground="#7C4A03" FontSize="12.5"/>
                                                    </Border>
                                                    <Path Data="M0,6 L18,6 M13,1 L18,6 L13,11" Stroke="#94A3B8" StrokeThickness="1.6" Margin="8,0" VerticalAlignment="Center"/>
                                                    <Border Background="#0F172A" CornerRadius="8" Padding="10,6" Margin="0,2">
                                                        <TextBlock Text="ERP" Foreground="White" FontSize="12.5"/>
                                                    </Border>
                                                </WrapPanel>
                                                <Path Grid.Column="2" Style="{StaticResource Chevron}" Margin="12,0,4,0"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="Remove" Style="{StaticResource QuietLink}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                Click="OnAskRemove" AutomationProperties.AutomationId="RemoveInboundType"
                                                Visibility="{Binding ConfirmRemove, Converter={StaticResource Match}, ConverterParameter=False}"/>
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                                                Padding="12,8" Margin="0,12,0,0" Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Keep" Style="{StaticResource SmallBtn}" Margin="0,0,8,0" Click="OnKeepItem"/>
                                                    <Button Content="Remove" Style="{StaticResource DangerSmall}" Click="OnRemoveInboundType" AutomationProperties.AutomationId="ConfirmRemoveInboundType"/>
                                                </StackPanel>
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12.5"><Run Text="Remove "/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" with all its companies? Nothing changes until you save."/></TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Every imported document has its steps in the dashboard under View, Document history, searchable by its id in the document system."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Inbound / one document type: its name and its companies ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Inbound/type}">
                <StackPanel Margin="40,8,40,24" DataContext="{Binding SelectedInboundType}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource InboundBadge}"><TextBlock Text="INBOUND" Foreground="#0F766E" FontWeight="Bold" FontSize="11"/></Border>
                    </StackPanel>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="DOCUMENT TYPE" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                     AutomationProperties.AutomationId="InboundTypeName"/>
                            <TextBlock Style="{StaticResource Hint}" Text="What the ERP receives, e.g. Purchase order or Vendor invoice. Shown in the document history."/>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,26,0,12">
                        <Button DockPanel.Dock="Right" Content="+ Add company" AutomationProperties.AutomationId="AddInboundCompany"
                                Command="{Binding DataContext.AddInboundCompanyCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <StackPanel>
                            <TextBlock Text="Companies" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Each company in your ERP that receives this document type. Open one to set where its documents come from and where the ERP reads them." Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Foreground="#92400E" TextWrapping="Wrap" Text="No company yet. + Add company sets up the first one. A document type without companies is not saved."
                               Visibility="{Binding Companies.Count, Converter={StaticResource CountToVis}, ConverterParameter=Empty}"/>
                    <ItemsControl ItemsSource="{Binding Companies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Bare}" Click="OnOpenInboundCompany" Padding="0,2"
                                                AutomationProperties.AutomationId="InboundCompanyCard" AutomationProperties.Name="{Binding CardTitle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="#F1F5F9" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CompanyBadge}" FontWeight="Bold" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CardTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                        <Border Background="#F1F5F9" CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding Enabled, Converter={StaticResource Match}, ConverterParameter=False}">
                                                            <TextBlock Text="Off" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CardSource}" FontSize="12.5" Foreground="#475569" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CardReady}" FontSize="12.5" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Path Grid.Column="2" Style="{StaticResource Chevron}" Margin="12,0,4,0"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="Remove" Style="{StaticResource QuietLink}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                Click="OnAskRemove" AutomationProperties.AutomationId="RemoveInboundCompany"
                                                Visibility="{Binding ConfirmRemove, Converter={StaticResource Match}, ConverterParameter=False}"/>
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                                                Padding="12,8" Margin="0,12,0,0" Visibility="{Binding ConfirmRemove, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Keep" Style="{StaticResource SmallBtn}" Margin="0,0,8,0" Click="OnKeepItem"/>
                                                    <Button Content="Remove" Style="{StaticResource DangerSmall}" Click="OnRemoveInboundCompany" AutomationProperties.AutomationId="ConfirmRemoveInboundCompany"/>
                                                </StackPanel>
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12.5"><Run Text="Remove "/><Run Text="{Binding CardTitle, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" from this document type? Nothing changes until you save."/></TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Inbound / where from: one tile per document system the service reads from ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Inbound/pick}">
                <StackPanel Margin="40,8,40,24">
                    <TextBlock Text="Where do the documents come from?" Style="{StaticResource PageTitle}"/>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,18" TextWrapping="Wrap"
                               Text="Choose the document system. Its own settings follow on the next screen."/>
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Bare}" Click="OnPickSource" Margin="0,0,14,14"
                                        AutomationProperties.AutomationId="SourceTile" AutomationProperties.Name="{Binding Name}">
                                    <Border Style="{StaticResource ListCard}" Margin="0" Padding="20">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border Width="44" Height="44" CornerRadius="11" Background="#F0F9FF">
                                                    <TextBlock Text="{Binding Initial}" Foreground="#0369A1" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFFBEB"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Background" Value="#F0FDF4"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Connect first"/>
                                                                <Setter Property="Foreground" Value="#92400E"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                                                        <Setter Property="Text" Value="Connected"/>
                                                                        <Setter Property="Foreground" Value="#166534"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" FontSize="13" Height="56"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="20,14" HorizontalAlignment="Left" Width="320">
                        <StackPanel>
                            <TextBlock Text="More systems" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Further document systems appear here when a Hive BDC update brings their connector."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Inbound / one company: comes from (the system's own settings) and goes to (CSV for the ERP) ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Inbound/company}">
                <StackPanel Margin="40,8,40,24" DataContext="{Binding OpenInbound}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Content="Active" FontSize="14" VerticalAlignment="Center"
                                  AutomationProperties.Name="Company active"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                            <Border Style="{StaticResource InboundBadge}"><TextBlock Text="INBOUND" Foreground="#0F766E" FontWeight="Bold" FontSize="11"/></Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Where this company's documents of the type "/><Run Text="{Binding DataContext.SelectedInboundType.Name, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/><Run Text=" come from, and where the ERP reads them."/>
                    </TextBlock>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="22">
                            <StackPanel>
                                <TextBlock Text="COMES FROM" Style="{StaticResource PanelTitle}"/>
                                <Border BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Change" Style="{StaticResource LinkBtn}" VerticalAlignment="Center" Click="OnChangeSource"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="36" Height="36" CornerRadius="9" Background="#F0F9FF">
                                                <TextBlock Text="{Binding Source.Initial}" Foreground="#0369A1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="Company in the ERP" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding DataAreaId, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"
                                         AutomationProperties.AutomationId="InboundCompanyId"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Also usable in the CSV as {DataAreaId}."/>
                                <ItemsControl ItemsSource="{Binding WhichSettings}" ItemTemplate="{StaticResource SourceSettingTemplate}" Margin="0,4,0,0"/>
                                <TextBlock Text="AFTER IMPORT" Style="{StaticResource PanelTitle}" Margin="0,22,0,0"/>
                                <ItemsControl ItemsSource="{Binding AfterSettings}" ItemTemplate="{StaticResource SourceSettingTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Path Grid.Column="1" Data="M4,6 L26,6 M20,0 L26,6 L20,12" Stroke="#94A3B8" StrokeThickness="1.8" VerticalAlignment="Top" Margin="2,64,0,0"/>

                        <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="22">
                            <StackPanel>
                                <TextBlock Text="GOES TO" Style="{StaticResource PanelTitle}"/>
                                <TextBlock Text="Folder the ERP reads" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="InboundFolder"/>
                                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BrowseBtn}" Command="{Binding BrowseFolderCommand}"/>
                                </Grid>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SaveFile}" Content="Save the document file next to the CSV" Margin="0,14,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Its path is {FilePath} in the CSV."/>
                                <TextBlock Text="CSV file name" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Separator" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding Delimiter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Numbers and dates" Style="{StaticResource Label}"/>
                                        <ComboBox ItemsSource="{x:Static vm:InboundFlowViewModel.NumberFormats}" SelectedItem="{Binding NumberFormat}" Height="40"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Visibility="{Binding HasTables, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="One CSV row per row of the table" Style="{StaticResource Label}"/>
                                    <ComboBox ItemsSource="{Binding TableChoices}" SelectedItem="{Binding RowsFrom}" Height="40"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="22">
                        <StackPanel>
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right">
                                    <Button Content="One column per field" Style="{StaticResource SmallBtn}" Margin="0,0,6,4" Command="{Binding FillFromFieldsCommand}"/>
                                    <Button Content="Columns from a CSV the ERP reads…" Style="{StaticResource SmallBtn}" Margin="0,0,6,4" Command="{Binding ColumnsFromCsvCommand}"/>
                                    <Button Content="Preview with a ready document" Style="{StaticResource SmallBtn}" Margin="0,0,0,4" Command="{Binding PreviewCommand}"
                                            AutomationProperties.AutomationId="InboundPreview"/>
                                </WrapPanel>
                                <TextBlock Text="CSV COLUMNS" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" Style="{StaticResource EditGrid}" MinHeight="70" MaxHeight="260" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Column" Width="*" Binding="{Binding Column, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Template, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Add row" Command="{Binding AddColumnCommand}" Style="{StaticResource SmallBtn}" Margin="0,0,6,6"/>
                                <Button Content="Remove" Command="{Binding RemoveColumnCommand}" Style="{StaticResource SmallBtn}" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{}{FIELD} takes a field of the document, {TABLE.COLUMN} a column of the table the rows come from, {FIELD:date} writes a date."/>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12.5"
                                       Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrush}}"/>
                            <ItemsControl ItemsSource="{Binding Preview}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#334155"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Connections ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Connections}">
                <StackPanel Margin="40,12,40,24">
                    <TextBlock Text="Connections" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Sign-ins Hive BDC uses. Set each up once; outbound and inbound flows choose where documents go." Foreground="#5B6474" FontSize="14" Margin="0,4,0,20"/>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Panel}" Margin="0,0,12,12" Padding="20">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="44" Height="44" CornerRadius="11" Background="#EEF4FF">
                                        <TextBlock Text="S" Foreground="#1D4ED8" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SharePointAppSetUp}" Value="True"><Setter Property="Background" Value="#F0FDF4"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Not set up"/>
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SharePointAppSetUp}" Value="True">
                                                            <Setter Property="Text" Value="Set up"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="Edit" Margin="0,16,0,0" AutomationProperties.AutomationId="EditSharePointApp"
                                        Command="{Binding OpenCommand}" CommandParameter="sharepoint-app"/>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="SharePoint" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SharePointAppDetail}" Style="{StaticResource Hint}" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Margin="0,0,12,12" Padding="20">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="44" Height="44" CornerRadius="11" Background="#F0F9FF">
                                        <TextBlock Text="D" Foreground="#0369A1" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DocuWareSetUp}" Value="True"><Setter Property="Background" Value="#F0FDF4"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Not set up"/>
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DocuWareSetUp}" Value="True">
                                                            <Setter Property="Text" Value="Set up"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="Edit" Margin="0,16,0,0" AutomationProperties.AutomationId="EditDocuWare"
                                        Command="{Binding OpenCommand}" CommandParameter="docuware"/>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="DocuWare" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DocuWareDetail}" Style="{StaticResource Hint}" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="20">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="44" Height="44" CornerRadius="11" Background="#F1F5F9">
                                        <TextBlock Text="M" Foreground="#475569" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MailSetUp}" Value="True"><Setter Property="Background" Value="#F0FDF4"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Not set up"/>
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MailSetUp}" Value="True">
                                                            <Setter Property="Text" Value="Set up"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="Edit" Margin="0,16,0,0" AutomationProperties.AutomationId="EditMail"
                                        Command="{Binding OpenCommand}" CommandParameter="mail"/>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Document mail" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MailDetail}" Style="{StaticResource Hint}" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>
                    <ItemsControl ItemsSource="{Binding OtherConnections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel}" Margin="0,0,12,12" Padding="20">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top">
                                            <Border Width="44" Height="44" CornerRadius="11" Background="#F1F5F9">
                                                <TextBlock Text="{Binding Initial}" Foreground="#475569" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFFBEB"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SetUp}" Value="True"><Setter Property="Background" Value="#F0FDF4"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Not set up"/>
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SetUp}" Value="True">
                                                                    <Setter Property="Text" Value="Set up"/>
                                                                    <Setter Property="Foreground" Value="#166534"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DockPanel>
                                        <Button DockPanel.Dock="Bottom" Content="Edit" Margin="0,16,0,0" Click="OnEditConnectionKind"
                                                AutomationProperties.AutomationId="EditConnectionKind" AutomationProperties.Name="{Binding Name}"/>
                                        <StackPanel Margin="0,14,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="13"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Passwords and secrets are stored encrypted on this machine when you save, and never shown again. Leave a password field empty to keep the stored one."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Connections / SharePoint ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Connections/sharepoint-app}">
                <StackPanel Margin="40,8,40,24" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="SharePoint" Style="{StaticResource PageTitle}"/>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="The Microsoft 365 app your IT registered for Hive BDC. One app serves every library."/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Tenant ID" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Client ID" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Client secret" Style="{StaticResource Label}"/>
                            <PasswordBox x:Name="SecretBox"/>
                            <TextBlock Text="{Binding SecretPlaceholderHint}" Style="{StaticResource Hint}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                       Text="Application permission Sites.ReadWrite.All or Sites.Selected. To test it, open a company's SharePoint library under Outbound and use Test this library. Inbound flows from SharePoint use the same app."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Connections / Document mail ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Connections/mail}">
                <StackPanel Margin="40,8,40,24" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="Document mail" Style="{StaticResource PageTitle}"/>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Sends each produced document through Microsoft 365, with its own app (application permission Mail.Send)."/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MailEnabled}" Content="Send document mails" FontSize="14"/>
                            <StackPanel IsEnabled="{Binding MailEnabled}">
                                <TextBlock Text="Send from" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                                <TextBox Text="{Binding MailFrom, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="The mailbox documents are sent as, e.g. invoices@yourcompany.com."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Client ID" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding MailClientId, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Client secret" Style="{StaticResource Label}"/>
                                        <PasswordBox x:Name="MailSecretBox"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding MailSecretPlaceholderHint}" Style="{StaticResource Hint}"/>
                                <TextBlock Text="Tenant ID (empty: the same as SharePoint)" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding MailTenantId, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Test recipients" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding MailRedirectTo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextWrapping="NoWrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Documents from a test or development ERP go here instead of to the customer or vendor. Separate with ; or one per line."/>
                                <CheckBox Content="Keep a copy in the sender's Sent Items" Margin="0,12,0,0" IsChecked="{Binding MailSaveToSentItems}"/>
                                <Border Height="1" Background="#EEF1F5" Margin="0,18,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Test mail" Click="OnTestMail"/>
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" Text="Checks the app and the mailbox. Sends nothing."/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Connections / DocuWare ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Connections/docuware}">
                <StackPanel Margin="40,8,40,24" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="DocuWare" Style="{StaticResource PageTitle}"/>
                    <TextBlock Foreground="#5B6474" FontSize="14" Margin="0,4,0,0" Text="Three things, then Hive BDC checks the sign-in."/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="1   Address of your DocuWare" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DocuWareUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Copy it from the browser when DocuWare is open, e.g. https://yourcompany.docuware.cloud."/>
                            <TextBlock Text="2   Integration user" FontWeight="SemiBold" Margin="0,20,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="User name" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DocuWareUserName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="DocuWareSecretBox"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding DocuWareSecretHint}" Style="{StaticResource Hint}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="A user allowed to sign in with a DocuWare password. Ask your DocuWare administrator for one."/>
                            <TextBlock Text="3   Check" FontWeight="SemiBold" Margin="0,20,0,6"/>
                            <Button Content="Test connection" HorizontalAlignment="Left" Click="OnTestDocuWare"/>
                            <Border CornerRadius="10" Padding="12" Margin="0,10,0,0"
                                    Visibility="{Binding DocuWareStatus, Converter={StaticResource Match}, ConverterParameter=!}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DocuWareStatusIsError}" Value="True"><Setter Property="Background" Value="#FEF2F2"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DocuWareStatus}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#166534"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DocuWareStatusIsError}" Value="True"><Setter Property="Foreground" Value="#B91C1C"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Service ══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding View, Converter={StaticResource Match}, ConverterParameter=Service}">
                <StackPanel Margin="40,12,40,24" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Service" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="How the Hive BDC service runs on this machine." Foreground="#5B6474" FontSize="14" Margin="0,4,0,20"/>
                    <Border Style="{StaticResource Panel}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Check for new documents every" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="80" Text="{Binding PollSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="seconds (at least 5)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#475569"/>
                            </StackPanel>
                            <TextBlock Text="Log folder" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding LogDir, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BrowseBtn}" Command="{Binding BrowseLogDirCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="Empty keeps the logs in %ProgramData%\HiveBDC\logs, one file per day."/>
                            <TextBlock Text="Licence" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0"
                                       Text="Managed on the dashboard with Renew licence: import the .lic file Balsoft sent you. Without a valid licence, or 7 days after it expired, processing stops."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Footer ══ -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="40,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel VerticalAlignment="Center" Margin="0,0,16,0"
                               Visibility="{Binding ConfirmClose, Converter={StaticResource Match}, ConverterParameter=False}">
                        <Border DockPanel.Dock="Left" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10"
                                Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center"
                                Visibility="{Binding JustSaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✓ Saved" Foreground="#166534" FontWeight="SemiBold" FontSize="12.5"
                                       AutomationProperties.AutomationId="SavedBadge"/>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrush}}"/>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ConfirmClose, Converter={StaticResource Match}, ConverterParameter=False}">
                        <Button Content="Close" Click="OnClose" Margin="0,0,8,0" AutomationProperties.AutomationId="CloseSettings"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Save changes" Click="OnSave" Style="{StaticResource PrimaryButton}" Padding="18,7"
                                AutomationProperties.AutomationId="SaveSettings"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" Foreground="#991B1B" FontWeight="SemiBold"
                               Text="Some changes are not saved yet. Close without saving them?"
                               Visibility="{Binding ConfirmClose, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ConfirmClose, Converter={StaticResource BoolToVis}}">
                        <Button Content="Keep editing" Click="OnKeepEditing" Margin="0,0,8,0" AutomationProperties.AutomationId="KeepEditing"/>
                        <Button Content="Close without saving" Click="OnCloseWithoutSaving" Style="{StaticResource DangerSmall}" Padding="14,7"
                                AutomationProperties.AutomationId="CloseWithoutSaving"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>