<Window x:Class="Balsoft.Hive.BDC.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hive BDC: Document history" Height="720" Width="1120"
        MinHeight="440" MinWidth="720"
        Icon="/Assets/hive-bdc-logo.png"
        FontFamily="Segoe UI, Tahoma"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBg}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Document history" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="260" KeyDown="OnSearchKeyDown"
                             ToolTip="Document number, or the first part of the file name"/>
                    <Button Content="Find" Command="{Binding RefreshCommand}" Margin="6,0,0,0" Padding="12,3"/>
                    <Button Content="Clear" Command="{Binding ClearSearchCommand}" Margin="6,0,0,0" Padding="10,3"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox Content="Needs attention only" IsChecked="{Binding AttentionOnly}" Foreground="White"
                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="All steps of this document" Command="{Binding ShowDocumentCommand}" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Retry" Command="{Binding RetryCommand}" IsEnabled="{Binding CanRetry}" Padding="16,4"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Put the stopped document's files back into its input folder. It is processed on the next scan; targets that already received it get no second copy."/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" Margin="20,12,20,12"
                  Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                            <Setter Property="Background" Value="#FFFBEB"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding At}" Width="140"/>
                <DataGridTextColumn Header="Document" Binding="{Binding Document}" Width="150"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                <DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="90"/>
                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="90"/>
                <DataGridTemplateColumn Header="What happened" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="2,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>