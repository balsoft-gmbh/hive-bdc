<Window x:Class="Balsoft.Hive.BDC.App.ImportFlowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Balsoft.Hive.BDC.App.ViewModels"
        Title="Hive BDC: Import from DocuWare" Height="760" Width="900"
        MinHeight="480" MinWidth="680"
        Icon="/Assets/hive-bdc-logo.png"
        FontFamily="Segoe UI, Tahoma"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBg}">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14">
            <TextBlock Text="Import from DocuWare" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
                <Button Content="OK" IsDefault="True" Click="OnOk" Padding="18,4" IsEnabled="{Binding CanSave}"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,12,20,12">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Name" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="File cabinet" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding Cabinets}" SelectedItem="{Binding SelectedCabinet}" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="One CSV row per row of the table (optional)" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding TableChoices}" SelectedItem="{Binding RowsFrom}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="A document is ready when" Style="{StaticResource Label}"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding ReadyFieldChoices}" Text="{Binding ReadyField, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Width="260"/>
                    <TextBlock Text="=" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ReadyValue, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="For example STATUS = Freigegeben. Only these documents are imported."/>

                <TextBlock Text="After the import, set that field to" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding DoneValue, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Hint}" Text="For example In AX. This keeps a document from being imported twice and shows in DocuWare that it reached the ERP."/>

                <TextBlock Text="Folder the ERP reads" Style="{StaticResource Label}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseFolderCommand}" Padding="10,2" Margin="6,0,0,0"/>
                </Grid>
                <CheckBox Content="Also save the document's file (PDF) in that folder; {FilePath} is its path" IsChecked="{Binding SaveFile}" Margin="0,8,0,0"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Numbers and dates" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{x:Static vm:ImportFlowViewModel.NumberFormats}" SelectedItem="{Binding NumberFormat}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="Separator" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Delimiter, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="File name" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="CSV columns, in this order" Style="{StaticResource Label}" Margin="0,16,0,3"/>
                <DataGrid ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" AutoGenerateColumns="False"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                          MinHeight="140" MaxHeight="320" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Column (as the ERP names it)" Width="*" Binding="{Binding Column, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Filled with" Width="*" Binding="{Binding Template, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Add row" Command="{Binding AddColumnCommand}" Padding="10,3" Margin="0,0,6,4"/>
                    <Button Content="Remove" Command="{Binding RemoveColumnCommand}" Padding="10,3" Margin="0,0,6,4"/>
                    <Button Content="Columns from a CSV file…" Command="{Binding ColumnsFromCsvCommand}" Padding="10,3" Margin="0,0,6,4"
                            ToolTip="Pick a CSV file the ERP already reads; its first line becomes the column list."/>
                    <Button Content="One column per DocuWare field" Command="{Binding FillFromFieldsCommand}" Padding="10,3" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Filled with: {FIELD} takes a DocuWare field by its database name, {TABLE.COLUMN} a column of the current table row, {DWDOCID} the DocuWare document id, {FilePath} the saved file. Text around it is kept."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>