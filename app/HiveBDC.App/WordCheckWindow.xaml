<Window x:Class="Balsoft.Hive.BDC.App.WordCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hive BDC — Check a Word file" Height="760" Width="1000"
        MinHeight="460" MinWidth="720"
        Icon="/Assets/hive-bdc-logo.png"
        FontFamily="Segoe UI, Tahoma"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBg}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Check a Word file" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding FileName}" Foreground="#93A3BC" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
                <TextBlock Text="{Binding Verdict}" Foreground="White" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Totals}" Foreground="#D1D8E4" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save PDF preview…" Click="OnSavePreview" Margin="0,0,8,0"
                        ToolTip="Render the PDF Hive BDC would make from this file and save it"/>
                <Button Content="Close" Click="OnClose" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,4,12,8">
                <Border Style="{StaticResource Card}" BorderBrush="#FCA5A5" Background="#FEF2F2"
                        Visibility="{Binding Problems.Count, Converter={StaticResource CountToVis}}">
                    <StackPanel>
                        <TextBlock Text="NOT READY" Style="{StaticResource CardTitle}" Foreground="#B91C1C"/>
                        <ItemsControl ItemsSource="{Binding Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#B91C1C" FontSize="12" Margin="0,1" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" BorderBrush="#93C5FD" Background="#EFF6FF"
                        Visibility="{Binding Notes.Count, Converter={StaticResource CountToVis}}">
                    <StackPanel>
                        <TextBlock Text="NOTES" Style="{StaticResource CardTitle}" Foreground="#1D4ED8"/>
                        <ItemsControl ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#1E3A8A" FontSize="12" Margin="0,1" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FIELDS" Style="{StaticResource CardTitle}"/>
                        <DataGrid ItemsSource="{Binding Fields}" IsReadOnly="True" AutoGenerateColumns="False"
                                  HeadersVisibility="Column" MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="90"/>
                                <DataGridTextColumn Header="Field" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="3*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LINES" Style="{StaticResource CardTitle}"/>
                        <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pos." Binding="{Binding Position}" Width="60"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                                <DataGridTextColumn Header="Net price" Binding="{Binding Price}" Width="110"/>
                                <DataGridTextColumn Header="VAT %" Binding="{Binding Vat}" Width="70"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>