<Application x:Class="Balsoft.Hive.BDC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Balsoft.Hive.BDC.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml"/>
                <ResourceDictionary Source="Theme/Icons.xaml"/>
                <ResourceDictionary Source="Theme/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToBrushConverter x:Key="RunningToBrush"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:StatusToBrushConverter x:Key="StatusBrush"/>
            <conv:CountToVisibilityConverter x:Key="CountToVis"/>
            <conv:LogLevelToBrushConverter x:Key="LogLevelBrush"/>
            <conv:WidthToColumnsConverter x:Key="WidthToColumns"/>
            <conv:MatchToVisibilityConverter x:Key="Match"/>
            <conv:AllEqualConverter x:Key="AllEqual"/>
            <conv:EqualsToBoolConverter x:Key="EqualsTo"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>