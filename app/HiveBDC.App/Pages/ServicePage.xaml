<UserControl x:Class="Balsoft.Hive.BDC.App.Pages.ServicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Fact" TargetType="StackPanel">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="0,14,24,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Service" Style="{StaticResource H1}"/>
            <TextBlock Text="Status, licence, updates and the log of this machine." Style="{StaticResource Lead}"/>
        </StackPanel>

        <Border Grid.Row="1" x:Name="TabsBar" Style="{StaticResource TabBar}" Margin="0,10,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabItem}" GroupName="ServiceTabs" Content="Status" AutomationProperties.AutomationId="TabStatus"
                             IsChecked="{Binding ServiceTab, Converter={StaticResource EqualsTo}, ConverterParameter=Status}"/>
                <RadioButton Style="{StaticResource TabItem}" GroupName="ServiceTabs" Content="Licence" AutomationProperties.AutomationId="TabLicence"
                             IsChecked="{Binding ServiceTab, Converter={StaticResource EqualsTo}, ConverterParameter=Licence}"/>
                <RadioButton Style="{StaticResource TabItem}" GroupName="ServiceTabs" Content="Updates" AutomationProperties.AutomationId="TabUpdates"
                             IsChecked="{Binding ServiceTab, Converter={StaticResource EqualsTo}, ConverterParameter=Updates}"/>
                <RadioButton Style="{StaticResource TabItem}" GroupName="ServiceTabs" Content="Technical log" AutomationProperties.AutomationId="TabLog"
                             IsChecked="{Binding ServiceTab, Converter={StaticResource EqualsTo}, ConverterParameter=Log}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" x:Name="StatusTab" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding DataContext.ServiceTab, ElementName=TabsBar, Converter={StaticResource Match}, ConverterParameter=Status}">
            <StackPanel Margin="0,0,0,8">
                <Border Style="{StaticResource Panel}" x:Name="StatusPanel">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeading}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding StartServiceCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="StartService" AutomationProperties.Name="Start the service">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource IconSmall}" Tag="{StaticResource Icon.Play}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Start"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}" Command="{Binding StopServiceCommand}" AutomationProperties.AutomationId="StopService" AutomationProperties.Name="Stop the service">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource IconSmall}" Tag="{StaticResource Icon.Square}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Stop"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Hive BDC service" Style="{StaticResource H2}"/>
                                    <Border Margin="10,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GreenSoft}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource Green}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ServiceStatus}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBody}">
                            <StackPanel>
                                <WrapPanel>
                                    <StackPanel Style="{StaticResource Fact}">
                                        <TextBlock Text="VERSION" Style="{StaticResource FactLabel}"/>
                                        <TextBlock Text="{Binding Version}" Style="{StaticResource FactValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Fact}">
                                        <TextBlock Text="COMPANIES" Style="{StaticResource FactLabel}"/>
                                        <TextBlock Text="{Binding CompanyCount}" Style="{StaticResource FactValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Fact}">
                                        <TextBlock Text="DOCUMENT TYPES" Style="{StaticResource FactLabel}"/>
                                        <TextBlock Text="{Binding DocumentTypes}" Style="{StaticResource FactValue}" ToolTip="{Binding DocumentTypesDetail}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Fact}">
                                        <TextBlock Text="CHECKS FOR DOCUMENTS EVERY" Style="{StaticResource FactLabel}"/>
                                        <TextBlock Text="{Binding PollInterval}" Style="{StaticResource FactValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Fact}">
                                        <TextBlock Text="SHAREPOINT" Style="{StaticResource FactLabel}"/>
                                        <TextBlock Text="{Binding SharePoint}" Style="{StaticResource FactValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Fact}">
                                        <TextBlock Text="CONNECTION" Style="{StaticResource FactLabel}"/>
                                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource FactValue}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding DocumentTypesDetail}" Style="{StaticResource WarnText}" Margin="0,12,0,0"
                                           Visibility="{Binding DocumentTypesDetail, Converter={StaticResource Match}, ConverterParameter=!}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" x:Name="SettingsPanel" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeading}">
                            <TextBlock Text="Settings" Style="{StaticResource H2}"/>
                        </Border>
                        <Border Style="{StaticResource PanelBody}" MaxWidth="720" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Check for new documents every" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="80" Text="{Binding PollSeconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Check for new documents every, in seconds"/>
                                    <TextBlock Text="seconds (at least 5)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                                <TextBlock Text="Log folder" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding LogDir, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Log folder"/>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseLogDirCommand}" AutomationProperties.Name="Browse for the log folder">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource IconSmall}" Tag="{StaticResource Icon.FolderOpen}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Browse…"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="Empty keeps the logs in %ProgramData%\HiveBDC\logs, one file per day."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" x:Name="AboutPanel" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeading}">
                            <TextBlock Text="About Hive BDC" Style="{StaticResource H2}"/>
                        </Border>
                        <Border Style="{StaticResource PanelBody}">
                            <StackPanel>
                                <WrapPanel>
                                    <StackPanel Style="{StaticResource Fact}">
                                        <TextBlock Text="APP VERSION" Style="{StaticResource FactLabel}"/>
                                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource FactValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Fact}">
                                        <TextBlock Text="MACHINE" Style="{StaticResource FactLabel}"/>
                                        <TextBlock Text="{Binding DataContext.MachineName, ElementName=TabsBar}" Style="{StaticResource FactValue}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                           Text="Document data stays on this machine. This app reads only the service's local status API. Hive BDC, by Balsoft. © Balsoft GmbH"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="2" x:Name="LicenceTab" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding DataContext.ServiceTab, ElementName=TabsBar, Converter={StaticResource Match}, ConverterParameter=Licence}">
            <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource SectionHeading}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Renew licence…" Style="{StaticResource PrimaryButton}" Command="{Binding RenewLicenseCommand}"
                                    VerticalAlignment="Center" AutomationProperties.AutomationId="RenewLicence"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Licence" Style="{StaticResource H2}"/>
                                <Border Margin="10,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LicenseState}" Value="Valid">
                                                    <Setter Property="Background" Value="{StaticResource GreenSoft}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Green}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LicenseState}" Value="Warning">
                                                    <Setter Property="Background" Value="{StaticResource AmberSoft}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Amber}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LicenseState}" Value="Grace">
                                                    <Setter Property="Background" Value="{StaticResource AmberSoft}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Amber}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LicenseState}" Value="Expired">
                                                    <Setter Property="Background" Value="{StaticResource RoseSoft}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Rose}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LicenseState}" Value="Invalid">
                                                    <Setter Property="Background" Value="{StaticResource RoseSoft}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Rose}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LicenseState}"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBody}">
                        <StackPanel>
                            <Border Style="{StaticResource NoticeError}" Margin="0,14,0,0" Visibility="{Binding LicenseBlocked, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Processing is stopped. Install a valid licence to resume." FontWeight="SemiBold" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
                            </Border>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource Fact}" Width="320">
                                    <TextBlock Text="CUSTOMER" Style="{StaticResource FactLabel}"/>
                                    <TextBlock Text="{Binding LicenseCustomer}" Style="{StaticResource FactValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Fact}">
                                    <TextBlock Text="EXPIRES" Style="{StaticResource FactLabel}"/>
                                    <TextBlock Text="{Binding LicenseExpires}" Style="{StaticResource FactValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Fact}" Visibility="{Binding LicenseInstance, Converter={StaticResource Match}, ConverterParameter=!}">
                                    <TextBlock Text="BOUND TO THE AZURE INSTANCE" Style="{StaticResource FactLabel}"/>
                                    <TextBlock Text="{Binding LicenseInstance}" Style="{StaticResource FactValue}" AutomationProperties.AutomationId="LicenceInstance"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding LicenseMessage}" Style="{StaticResource FactValue}" Margin="0,14,0,0"
                                       Visibility="{Binding LicenseMessage, Converter={StaticResource Match}, ConverterParameter=!}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                       Text="Renew licence imports the .lic file Balsoft sent you. Without a valid licence, or 7 days after it expired, processing stops."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <ScrollViewer Grid.Row="2" x:Name="UpdatesTab" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding DataContext.ServiceTab, ElementName=TabsBar, Converter={StaticResource Match}, ConverterParameter=Updates}">
            <StackPanel Margin="0,0,0,8">
                <Border Style="{StaticResource Panel}" x:Name="UpdatesPanel">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeading}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding CheckForUpdatesCommand}" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="CheckForUpdates" AutomationProperties.Name="Check for updates">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource IconSmall}" Tag="{StaticResource Icon.Download}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Check for updates"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Updates" Style="{StaticResource H2}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBody}">
                            <WrapPanel>
                                <StackPanel Style="{StaticResource Fact}">
                                    <TextBlock Text="THIS VERSION" Style="{StaticResource FactLabel}"/>
                                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource FactValue}"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" x:Name="ReleaseNotesPanel" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeading}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="RefreshReleaseNotes" AutomationProperties.Name="Refresh the release notes">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource IconSmall}" Tag="{StaticResource Icon.RefreshCw}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Release notes" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" Margin="12,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Releases}" Margin="14,4,14,16" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Changes}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="5" Height="5" Fill="{StaticResource Gold}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,7,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" x:Name="LogTab"
              Visibility="{Binding DataContext.ServiceTab, ElementName=TabsBar, Converter={StaticResource Match}, ConverterParameter=Log}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Type" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding TypeChoices}" SelectedValue="{Binding LogType}" SelectedValuePath="Id" DisplayMemberPath="Label"
                              Width="190" Margin="0,0,12,0" AutomationProperties.AutomationId="LogType" AutomationProperties.Name="Type"/>
                    <Button Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="OpenLogFolder" AutomationProperties.Name="Open log folder">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource IconSmall}" Tag="{StaticResource Icon.FolderOpen}" Margin="0,0,6,0"/>
                            <TextBlock Text="Open log folder"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshLog"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <WrapPanel TextElement.FontSize="12" TextElement.Foreground="{StaticResource Muted}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                            <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource LogInfo}"/>
                            <TextBlock Text="Info" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                            <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource LogUi}"/>
                            <TextBlock Text="Dashboard action" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                            <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource LogWarn}"/>
                            <TextBlock Text="Warning" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                            <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource LogError}"/>
                            <TextBlock Text="Error" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                            <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource LogDebug}"/>
                            <TextBlock Text="Debug" Margin="6,0,0,0"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" AutomationProperties.AutomationId="LogStatus"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Panel}" ClipToBounds="True">
                <ListBox x:Name="LogList" Style="{StaticResource LogList}" ItemsSource="{Binding LogLines}" AutomationProperties.Name="Technical log, newest first"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>